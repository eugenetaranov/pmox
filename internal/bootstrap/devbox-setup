# GitHub login is interactive (device code in the browser), so it runs after
# the spinner steps, in the foreground. A_GH_MODE says how the VM reaches
# GitHub: agent (the SSH agent forwarded with `pmox shell -A`; no key on
# this VM), key (~/.ssh/id_ed25519, uploaded) or token (a pasted
# fine-grained token; git over HTTPS). Unset (answers from before modes) is key.
github_login() {
  local home pub title mode scopes; home=$(user_home); pub="$home/.ssh/id_ed25519.pub"; title="$(hostname) ($A_USER)"
  mode=${A_GH_MODE:-key}
  echo
  header "GitHub"
  as_user sh -c 'mkdir -p ~/.ssh && chmod 700 ~/.ssh && touch ~/.ssh/known_hosts'
  # GitHub's published host keys, not a first-use scan.
  as_user ssh-keygen -F github.com >/dev/null 2>&1 || as_user sh -c 'cat >> ~/.ssh/known_hosts' < "$CONF/github_known_hosts"
  if [ "$mode" = key ]; then
    [ -f "$pub" ] || install_sshkey
    if [ "${GH_PASSPHRASE:-}" = yes ] && [ "$INTERACTIVE" = 1 ] && as_user ssh-keygen -y -P "" -f "${pub%.pub}" >/dev/null 2>&1; then
      faint "Choose a passphrase for ${pub%.pub} (ssh-keygen asks twice):"
      as_user ssh-keygen -p -q -P "" -f "${pub%.pub}" || warn "Passphrase not set; run 'ssh-keygen -p -f ~/.ssh/id_ed25519' later."
    fi
  fi

  scopes=user:email
  [ "$mode" = key ] && scopes="admin:public_key,$scopes"
  picked gitsign && [ "$mode" != token ] && scopes="$scopes,admin:ssh_signing_key"
  if gh_logged_in; then
    faint "gh is already logged in."
  elif [ "$mode" = token ]; then
    if [ -z "${GH_TOKEN_IN:-}" ]; then
      note "GitHub: no token yet — run: gh auth login --with-token < token.txt && gh auth setup-git"
      return 0
    fi
    printf '%s' "$GH_TOKEN_IN" | as_user sh -c 'cd && gh auth login -h github.com -p https --with-token' || {
      warn "GitHub did not accept the token; run 'gh auth login --with-token' later."; return 0; }
    record gh_login
  elif [ "$INTERACTIVE" = 0 ]; then
    note "GitHub: not logged in — run 'gh auth login' (or 'sudo devbox-setup' to be asked)."
    return 0
  else
    faint "Open the URL below on any machine and enter the code."
    as_user sh -c "cd && gh auth login -h github.com -p ssh --skip-ssh-key -w -s $scopes" || {
      warn "GitHub login skipped; run 'gh auth login' later."; return 0; }
    record gh_login
  fi

  case "$mode" in
    token)
      as_user sh -c 'cd && gh config set -h github.com git_protocol https && gh auth setup-git' ;;
    agent)
      if [ -n "${SSH_AUTH_SOCK:-}" ] && as_user ssh-add -l >/dev/null 2>&1; then
        local out; out=$(as_user ssh -T -o BatchMode=yes git@github.com 2>&1 || true)
        case "$out" in
          *"successfully authenticated"*) ok "✓ git over SSH works through your forwarded agent" ;;
          *) warn "GitHub did not accept a key from your forwarded agent: $out" ;;
        esac
      else
        note "GitHub: git over SSH uses your forwarded SSH agent — connect with 'pmox shell -A' (or set forward_agent: true in pmox's config)."
      fi ;;
    key)
      local keys; keys=$(as_user gh ssh-key list 2>/dev/null || true)
      if [ -f "$pub" ] && [[ "$keys" != *"$(cut -d' ' -f2 "$pub")"* ]]; then
        gh_ensure_scope admin:public_key || return 0
        if as_user gh ssh-key add "$pub" --title "$title"; then
          ok "✓ SSH key added to GitHub as '$title'"
          record_gh_key "$pub" "$title" auth
          faint "If an organization uses SAML SSO, authorize this key: https://github.com/settings/keys → Configure SSO"
        else
          warn "Could not add the SSH key; add $pub at https://github.com/settings/keys"
        fi
      fi ;;
  esac
  github_identity
}

# gh_ensure_scope SCOPE — add SCOPE to gh's login (it asks in the browser);
# without a terminal, leave a note and return 1.
gh_ensure_scope() {
  gh_has_scope "$1" && return 0
  if [ "$INTERACTIVE" = 0 ]; then
    note "GitHub: the gh login lacks $1 — run: gh auth refresh -h github.com -s $1, then 'sudo devbox-setup --yes'."
    return 1
  fi
  faint "gh needs the $1 scope: open the URL below and enter the code."
  as_user sh -c "cd && gh auth refresh -h github.com -s $1" || { warn "Scope $1 not added."; return 1; }
}

# github_identity — fill a missing git identity from the GitHub account:
# a verified email (primary first; asks when there are several), the
# noreply address only when there's nothing else.
github_identity() {
  [ -z "$(as_user git config --global user.email 2>/dev/null || true)" ] || return 0
  local login name email emails n
  login=$(as_user gh api user -q .login 2>/dev/null || true)
  name=$(as_user gh api user -q '.name // .login' 2>/dev/null || true)
  emails=$(as_user gh api user/emails -q '.[] | select(.verified) | "\(.primary)\t\(.email)"' 2>/dev/null | sort -r | cut -f2 || true)
  n=$(printf '%s' "$emails" | grep -c . || true)
  if [ "$n" -gt 1 ] && [ "$INTERACTIVE" = 1 ]; then
    # shellcheck disable=SC2086
    email=$(gum choose --header "Git email (verified on GitHub)" $emails || true)
  else
    email=$(printf '%s\n' "$emails" | sed -n 1p)
  fi
  [ -n "$email" ] || email=$(as_user gh api user -q '.email // empty' 2>/dev/null || true)
  [ -z "$email" ] && [ -n "$login" ] && email="$(as_user gh api user -q .id)+$login@users.noreply.github.com"
  if [ -n "$email" ]; then
    as_user git config --global user.name "$name"
    as_user git config --global user.email "$email"
    ok "✓ git identity: $name <$email>"
  fi
}

# install_gitsign — sign commits and tags with SSH: the forwarded agent's
# key (agent mode) or ~/.ssh/id_ed25519, uploaded as a signing key. Runs in
# the foreground after the GitHub login (the scope may need the browser).
install_gitsign() {
  local home mode key signingkey email allowed title; home=$(user_home); mode=${A_GH_MODE:-key}
  title="$(hostname) ($A_USER) signing"
  echo
  header "Commit signing"
  if [ "$mode" = agent ]; then
    key=$(as_user ssh-add -L 2>/dev/null | sed -n 1p || true)
    if [ -z "$key" ] || [[ "$key" == "The agent has no identities"* ]]; then
      note "Commit signing: no key in your forwarded agent — reconnect with 'pmox shell -A' and run 'sudo devbox-setup --yes'."
      return 0
    fi
    signingkey="key::$key"
  else
    key=$(cat "$home/.ssh/id_ed25519.pub" 2>/dev/null || true)
    [ -n "$key" ] || { note "Commit signing: no ~/.ssh/id_ed25519.pub yet; run 'sudo devbox-setup --yes' after the GitHub step."; return 0; }
    signingkey="$home/.ssh/id_ed25519.pub"
  fi
  email=$(as_user git config --global user.email 2>/dev/null || true)
  allowed="$home/.config/git/allowed_signers"
  as_user git config --global gpg.format ssh
  as_user git config --global user.signingkey "$signingkey"
  as_user git config --global commit.gpgsign true
  as_user git config --global tag.gpgsign true
  as_user git config --global gpg.ssh.allowedSignersFile "$allowed"
  as_user mkdir -p "$(dirname "$allowed")"
  local line; line="${email:-*} $(cut -d' ' -f1,2 <<< "$key")"
  as_user sh -c 'touch "$1"; grep -qxF "$2" "$1" || echo "$2" >> "$1"' _ "$allowed" "$line"
  ok "✓ git signs commits with $(cut -d' ' -f1 <<< "$key")"

  if [ "$mode" = token ]; then
    note "Commit signing: add your key as a Signing Key at https://github.com/settings/ssh/new so GitHub shows commits as verified."
    return 0
  fi
  gh_logged_in || { note "Commit signing: log gh in, then run 'sudo devbox-setup --yes' to upload the signing key."; return 0; }
  gh_ensure_scope admin:ssh_signing_key || return 0
  if as_user gh api user/ssh_signing_keys -q '.[].key' 2>/dev/null | grep -qF "$(cut -d' ' -f2 <<< "$key")"; then
    return 0
  fi
  local tmp; tmp=$(mktemp); chmod 644 "$tmp"
  printf '%s\n' "$key" > "$tmp"
  if as_user gh ssh-key add "$tmp" --type signing --title "$title"; then
    ok "✓ signing key added to GitHub as '$title'"
    record_gh_key "$tmp" "$title" signing
  else
    warn "Could not add the signing key; add it at https://github.com/settings/ssh/new (Signing Key)."
  fi
  rm -f "$tmp"
}

# record_gh_key PUB TITLE auth|signing — record the uploaded key's GitHub id.
record_gh_key() {
  local api=user/keys id; [ "$3" = signing ] && api=user/ssh_signing_keys
  id=$(as_user gh api "$api" -q ".[] | select(.key | startswith(\"$(cut -d' ' -f1,2 "$1")\")) | .id" 2>/dev/null | head -n 1)
  [ -n "$id" ] && record gh_key "$id	$2	$3"
  return 0
}

# run_id ID — install one catalog entry.
run_id() {
  case "$(how_of "$1")" in
    apt)  # shellcheck disable=SC2046
          apt_install $(what_of "$1") ;;
    mise) # shellcheck disable=SC2046
          mise_use $(what_of "$1") ;;
    fn|ask) "install_$1" ;;
  esac
  # post_ID: settings that go with an apt or mise item.
  if declare -F "post_$1" >/dev/null; then "post_$1"; fi
}

# step ID TITLE CMD... — run CMD with its output in the log, behind a
# spinner; a failure is recorded under ID.
step() {
  local id=$1 title=$2 rc=0; shift 2
  echo "=== $title" >> "$LOG"
  "$@" >> "$LOG" 2>&1 &
  local pid=$!
  if [ -t 1 ]; then
    gum spin --title "$title" -- sh -c "while kill -0 $pid 2>/dev/null; do sleep 0.2; done" || true
  else
    say "… $title"
  fi
  wait "$pid" || rc=$?
  if [ "$rc" -eq 0 ]; then
    ok "✓ $title"
  else
    err "✗ $title (exit $rc) — last lines of $LOG:"
    tail -n 25 "$LOG" | sed 's/^/    /'
    FAILED="$FAILED $id"
  fi
  return 0
}

FAILED=
# begin_run — the start of an install run: a fresh log and notes, and apt
# settings for vendor scripts.
begin_run() {
  mkdir -p "$STATE"; : > "$LOG"; chmod 600 "$LOG"; rm -f "$STATE/.apt-fresh" "$STATE/.notes"
  # Every apt-get waits for the dpkg lock instead of failing, including
  # those inside vendor install scripts (tailscale, …). pmox also turns off
  # unattended-upgrades at boot; this covers older VMs and other hosts.
  printf '%s\n' 'DPkg::Lock::Timeout "900";' \
    'Dpkg::Options { "--force-confdef"; "--force-confold"; };' \
    | put_file /etc/apt/apt.conf.d/90devbox-setup 0644 || true
}

# sync_mcp — register the picked MCP servers with the running gateway.
sync_mcp() {
  echo
  header "MCP servers"
  curl -s -o /dev/null "http://127.0.0.1:$MCPJUNGLE_PORT/" || \
    warn "mcpjungle is not answering on port $MCPJUNGLE_PORT; check: journalctl -u mcpjungle"
  as_user env MCP_CATALOG="$CATALOG" MCPJUNGLE_REGISTRY="http://127.0.0.1:$MCPJUNGLE_PORT" \
    "$BIN/mcp-sync" $A_MCP_SERVERS || warn "Some servers did not register (see above)."
  faint "Change credentials in ~$A_USER/.mcp/<name>/env, then run mcp-sync as $A_USER."
}

# read_secrets — the typed secrets the Go devbox-setup passes on stdin:
# CRED:<item> <KEY>, MCP:<server> <KEY>, REG_USER:<registry>,
# REG_PASS:<registry>, and TS_AUTHKEY, GH_TOKEN_IN, GH_PASSPHRASE,
# AGE_CHOICE, AGE_KEY.
read_secrets() {
  local k v
  while IFS= read -r -d '' k && IFS= read -r -d '' v; do
    case "$k" in
      CRED:*) CRED["${k#CRED:}"]=$v ;;
      MCP:*) MCP_KEYS["${k#MCP:}"]=$v ;;
      REG_USER:*) REG_USER["${k#REG_USER:}"]=$v ;;
      REG_PASS:*) REG_PASS["${k#REG_PASS:}"]=$v ;;
      TS_AUTHKEY|GH_TOKEN_IN|GH_PASSPHRASE|AGE_CHOICE|AGE_KEY) printf -v "$k" '%s' "$v" ;;
    esac
  done
  return 0
}

# only ID — install one item from the saved answers, no questions (the Go
# devbox-setup's legacy step). Output goes to stdout, for its log.
only() {
  case "$1" in
    github) github_login ;;
    gitsign) install_gitsign ;;
    mcpjungle) run_id mcpjungle; sync_mcp ;;
    *) run_id "$1" ;;
  esac
}

# finish_run — the end of a run: the notes, and ~/devbox-setup.txt.
finish_run() {
  if [ -s "$STATE/.notes" ]; then
    echo
    while IFS= read -r l; do warn "! $l"; done < "$STATE/.notes"
  fi
  write_manage_notes
  if [ "$MISSING_COUNT" -gt 0 ]; then
    warn "$MISSING_COUNT secret(s) to fill in — see ~$A_USER/devbox-setup.txt"
  fi
}

apply() {
  begin_run
  local id
  for id in $PLAN; do
    case "$id" in github|gitsign|registries) continue ;; esac
    # Skip what depends on a step that failed.
    local n skip=
    for n in $(needs_of "$id"); do case " $FAILED " in *" $n "*) skip=$n ;; esac; done
    if [ "$(how_of "$id")" = mise ]; then case " $FAILED " in *" mise "*) skip=mise ;; esac; fi
    if [ -n "$skip" ]; then warn "- $(label_of "$id") (skipped: $skip failed)"; continue; fi
    step "$id" "$(label_of "$id")" run_id "$id"
  done
  if [ -n "$RUN_MISE_EXTRA" ] && ! picked_failed mise; then
    # shellcheck disable=SC2086
    step mise-extra "mise: $RUN_MISE_EXTRA" mise_use $RUN_MISE_EXTRA
  fi

  if [ -f "$(user_home)/.config/devbox/completions.zsh" ] && command -v zsh >/dev/null; then
    step zshcomp "zsh completions for installed tools" prime_zsh_completions
  fi

  if picked mcpjungle && ! picked_failed mcpjungle; then sync_mcp; fi
  if picked github && ! picked_failed essentials; then github_login; fi
  if picked gitsign && ! picked_failed essentials; then install_gitsign; fi
  if picked registries && ! picked_failed docker; then
    step registries "$(label_of registries)" install_registries
  fi

  finish_run
  faint "How each tool was installed and how to update it: ~$A_USER/devbox-setup.txt"
  faint "Start a new shell (log out and back in) to pick up the new shell, groups and PATH."
  faint "Log: $LOG"
  [ -z "$FAILED" ] || { err "Failed:$FAILED — fix and re-run devbox-setup."; exit 1; }
}
picked_failed() { case " $FAILED " in *" $1 "*) return 0 ;; esac; return 1; }

MISSING_COUNT=0
CRED_ITEMS="agentkeys npmrc registries agekey mcpjungle github tailscale"
has_cred_items() { local i; for i in $CRED_ITEMS; do case " $1 " in *" $i "*) return 0 ;; esac; done; return 1; }

# missing_secrets IDS — one line per credential the items in IDS still
# need: "FILE  KEY — where to get it[; then: command]".
missing_secrets() {
  local ids=" $1 " home r item key kind prompt how when def f n k
  home=$(user_home)
  case "$ids" in *" agentkeys "*)
    f="$home/.config/devbox/agent.env"
    for r in "${CRED_ROWS[@]}"; do
      IFS='|' read -r item key kind prompt how when def <<< "$r"
      [ "$item" = agentkeys ] && [ "$kind" = secret ] || continue
      { [ -z "$when" ] || user_has "$when"; } || continue
      [ -z "$(envget "$key" "$f")" ] && ! cred_logged_in "$key" && echo "$f  $key — $how"
    done ;;
  esac
  case "$ids" in *" npmrc "*)
    [ -n "$A_NPM_SCOPE" ] && [ -z "$(npmrc_token)" ] && \
      echo "$home/.npmrc  _authToken in the devbox-setup block ($A_NPM_SCOPE) — a token with read:packages: https://github.com/settings/tokens" ;;
  esac
  case "$ids" in *" registries "*)
    for r in $A_REGISTRIES; do
      reg_logged_in "$r" || echo "$home/.docker/config.json  $r — run: docker login $r"
    done ;;
  esac
  case "$ids" in *" agekey "*)
    grep -q '^AGE-SECRET-KEY-' "$home/.config/sops/age/keys.txt" 2>/dev/null || \
      echo "$home/.config/sops/age/keys.txt  AGE-SECRET-KEY — paste your key, or run: age-keygen -o ~/.config/sops/age/keys.txt" ;;
  esac
  case "$ids" in *" mcpjungle "*)
    for n in $A_MCP_SERVERS; do
      spec_file "$n" >/dev/null || continue
      for k in $(spec_field "$n" REQUIRED); do
        [ -z "$(envget "$k" "$home/.mcp/$n/env")" ] && echo "$home/.mcp/$n/env  $k — see the comments in the file; then run: mcp-sync"
      done
    done ;;
  esac
  case "$ids" in *" github "*)
    gh_logged_in || echo "gh  GitHub login — run: gh auth login" ;;
  esac
  case "$ids" in *" tailscale "*)
    have tailscale && ! tailscale status >/dev/null 2>&1 && echo "tailscale  login — run: sudo tailscale up" ;;
  esac
  return 0
}

# write_manage_notes — ~/devbox-setup.txt: everything installed so far,
# grouped by how it was installed, with how to manage it.
write_manage_notes() {
  local all id mise_l= apt_l= other_l= f
  all=$(resolve "$(merge "$A_PICKS" "$RUN_PICKS")")
  for id in $all; do
    [ "$id" = mise ] && continue
    local how; how=$(how_of "$id")
    [[ "$(source_of "$id")" == "apt install "* ]] && how=apt
    case "$how" in
      mise) mise_l="$mise_l  $(printf '%-40s' "$(label_of "$id")") $(source_of "$id")\n" ;;
      apt)  apt_l="$apt_l  $(printf '%-40s' "$(label_of "$id")") $(source_of "$id")\n" ;;
      *)    other_l="$other_l  $(printf '%-40s' "$(label_of "$id")") $(source_of "$id")\n" ;;
    esac
  done
  local extra; extra=$(merge "$A_MISE_EXTRA" "$RUN_MISE_EXTRA")
  [ -n "$extra" ] && mise_l="$mise_l  $(printf '%-40s' "Extra mise tools") mise use -g $extra\n"
  f="$(user_home)/devbox-setup.txt"
  {
    echo "devbox-setup — what is installed and how to manage it (updated $(date -u +%Y-%m-%d))"
    echo
    if [ -n "$mise_l" ]; then
      echo "Installed with mise (per user, ~/.config/mise/config.toml):"
      printf '%b' "$mise_l"
      echo "  update all: mise up · list: mise ls · pin: mise use -g <tool>@<version> · remove: mise rm -g <tool>"
      echo
    fi
    if [ -n "$apt_l" ]; then
      echo "Installed with apt (system):"
      printf '%b' "$apt_l"
      echo "  update: sudo apt update && sudo apt upgrade · remove: sudo apt remove <package>"
      echo
    fi
    if [ -n "$other_l" ]; then
      echo "Vendor repos, release binaries, scripts and settings:"
      printf '%b' "$other_l"
      echo "  vendor apt repos update with apt upgrade; claude and omp update themselves."
      echo
    fi
    case " $all " in *" github "*)
      echo "GitHub (${A_GH_MODE:-key} mode):"
      case "${A_GH_MODE:-key}" in
        agent) echo "  git over SSH uses your laptop's SSH agent: connect with 'pmox shell -A' (or forward_agent: true in pmox's config)." ;;
        token) echo "  git uses HTTPS with your token through gh; when it expires: gh auth login --with-token" ;;
        *)     if python3 "$SHARE/picker.py" created list "$STATE" | grep -q '^gh_key.*auth$'; then
                 echo "  ~/.ssh/id_ed25519 is on your GitHub account (https://github.com/settings/keys)."
               else
                 echo "  ~/.ssh/id_ed25519 is not on GitHub yet: log gh in, then run 'sudo devbox-setup --yes'."
               fi
               echo "  For an organization with SAML SSO, authorize the key at https://github.com/settings/keys (Configure SSO)." ;;
      esac
      echo "  Remove what devbox-setup added to GitHub and this VM: sudo devbox-setup forget"
      echo ;;
    esac
    local missing; missing=$(missing_secrets "$all")
    MISSING_COUNT=$(printf '%s' "$missing" | grep -c . || true)
    if [ -n "$missing" ]; then
      echo "Secrets to fill in (devbox-setup never stores them: put each in its file, then run the command):"
      printf '%s\n' "$missing" | sed "s|$(user_home)/|~/|g; s/^/  /"
      echo
    elif has_cred_items "$all"; then
      echo "Secrets to fill in: none."
      echo
    fi
    local agepub; agepub=$(as_user_sh "age-keygen -y ~/.config/sops/age/keys.txt" 2>/dev/null || true)
    [ -n "$agepub" ] && { echo "age public key (for .sops.yaml recipients): $agepub"; echo; }
    echo "Run 'sudo devbox-setup' again to add more."
  } > "$f"
  chown -h "$A_USER:" "$f"
}

# --- forget ---------------------------------------------------------------------

# forget — undo what devbox-setup created and recorded in created.json, and
# nothing else: the GitHub keys it uploaded, its registry logins, the
# values in the credential files it wrote and its blocks in yours, and the
# gh and Tailscale logins it made. Prints where to revoke the tokens it
# can't revoke itself.
forget() {
  local entries kind v1 v2 v3 rc=0 f links=
  entries=$(python3 "$SHARE/picker.py" created list "$STATE")
  header "devbox-setup forget"
  if [ -z "$entries" ]; then
    say "devbox-setup has no record of creating anything on this VM."
    say "Keys uploaded by a devbox-setup older than this record: check https://github.com/settings/keys"
    return 0
  fi
  say "This removes, for $A_USER:"
  while IFS=$'\t' read -r kind v1 v2 v3; do
    case "$kind" in
      gh_key)    say "  - GitHub $v3 key '$v2' (id $v1)" ;;
      gh_login)  say "  - the gh login on this VM" ;;
      registry)  say "  - the docker login to $v1" ;;
      file)      say "  - the values in $v1" ;;
      block)     say "  - devbox-setup's block in $v1" ;;
      tailscale) say "  - this VM's Tailscale login" ;;
    esac
  done <<< "$entries"
  if [ "$YES" = 0 ]; then
    [ -t 0 ] || die "forget needs a terminal to confirm (or --yes)"
    printf 'Remove them? [y/N] '
    local a; read -r a
    case "$a" in y|Y|yes) ;; *) say "Nothing removed."; return 0 ;; esac
  fi

  # Tokens in the files, for the revoke list (before they are emptied).
  while IFS=$'\t' read -r kind v1 v2 v3; do
    case "$kind" in file|block) [ -f "$v1" ] || continue ;; *) continue ;; esac
    links="$links$(revoke_hints "$v1")\n"
  done <<< "$entries"

  # 1. GitHub keys, while gh is still logged in.
  while IFS=$'\t' read -r kind v1 v2 v3; do
    [ "$kind" = gh_key ] || continue
    local api=user/keys; [ "$v3" = signing ] && api=user/ssh_signing_keys
    local out; out=$(as_user gh api -X DELETE "$api/$v1" 2>&1) || case "$out" in
      *"Not Found"*|*404*) ;;
      *) warn "✗ GitHub key '$v2': $out"; rc=1; continue ;;
    esac
    ok "✓ removed the GitHub key '$v2'"
    unrecord gh_key "$v1	$v2	$v3"
  done <<< "$entries"
  # 2. Registry logins.
  while IFS=$'\t' read -r kind v1 _; do
    [ "$kind" = registry ] || continue
    if as_user docker logout "$v1" >/dev/null 2>&1; then ok "✓ logged out of $v1"; unrecord registry "$v1"
    else warn "✗ docker logout $v1"; rc=1; fi
  done <<< "$entries"
  # 3. Credential files keep their keys (a re-run asks again); blocks go.
  while IFS=$'\t' read -r kind v1 _; do
    case "$kind" in file|block) ;; *) continue ;; esac
    f=$v1
    [ -f "$f" ] || { unrecord "$kind" "$f"; continue; }
    local tmp; tmp=$(mktemp)
    awk -v b="$NPMRC_BEGIN" -v e="$NPMRC_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$f" \
      | sed -e 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1=/' -e '/^AGE-SECRET-KEY-/d' > "$tmp"
    if [ "$kind" = block ]; then
      awk -v b="$NPMRC_BEGIN" -v e="$NPMRC_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$f" > "$tmp"
      unrecord block "$f"
    fi
    cat "$tmp" > "$f"; rm -f "$tmp"
    ok "✓ emptied the secrets in $f"
  done <<< "$entries"
  # 4–5. Logins.
  if grep -q '^gh_login' <<< "$entries"; then
    if as_user gh auth logout -h github.com </dev/null >/dev/null 2>&1 || ! gh_logged_in; then
      ok "✓ logged gh out"; unrecord gh_login
    else warn "✗ gh auth logout"; rc=1; fi
  fi
  if grep -q '^tailscale' <<< "$entries"; then
    if tailscale logout >/dev/null 2>&1; then ok "✓ logged out of Tailscale"; unrecord tailscale
    else warn "✗ tailscale logout"; rc=1; fi
  fi

  echo
  say "Tokens can only be revoked where they were made:"
  printf '%b' "$links" | { grep . || true; } | sort -u | sed 's/^/  /'
  grep -q '^gh_login' <<< "$entries" && say "  GitHub tokens and authorized apps: https://github.com/settings/applications"
  return "$rc"
}
unrecord() { python3 "$SHARE/picker.py" created remove "$STATE" "$@"; }

# revoke_hints FILE — "where to revoke" lines for the secrets set in FILE.
revoke_hints() {
  local key v r item k kind prompt how when def
  while IFS='=' read -r key v; do
    case "$key" in ''|\#*|*[!A-Za-z0-9_]*) continue ;; esac
    [ -n "$v" ] && is_secret "$key" || continue
    how=
    for r in "${CRED_ROWS[@]}"; do
      IFS='|' read -r item k kind prompt how when def <<< "$r"
      [ "$k" = "$key" ] && break
      how=
    done
    printf '%s\n' "$key: ${how:-revoke it where it was created (see the comment in $1)}"
  done < "$1"
  grep -q '_authToken=.' "$1" && printf '%s\n' "npm token: https://github.com/settings/tokens (or your registry's token page)"
  return 0
}

dry_run() {
  say "user: $A_USER"
  local id
  for id in $PLAN; do
    case "$(how_of "$id")" in
      apt)  say "apt:  $(what_of "$id")" ;;
      mise) say "mise: $(what_of "$id")" ;;
      *)    say "step: $(label_of "$id")" ;;
    esac
  done
  [ -n "$RUN_MISE_EXTRA" ] && say "mise: $RUN_MISE_EXTRA"
  picked mcpjungle && say "mcpjungle: listen $A_MCP_LISTEN:$MCPJUNGLE_PORT · servers: $A_MCP_SERVERS · wire agents: ${A_WIRE_AGENTS:-no}"
  return 0
}

# --- Main ------------------------------------------------------------------------

load_answers
if [ "$FORGET" = 1 ]; then
  A_USER=${A_USER:-${SUDO_USER:-$(id -un)}}
  forget
  exit $?
fi
if [ -n "$ONLY" ] || [ "$BEGIN" = 1 ] || [ "$FINISH" = 1 ]; then
  id "$A_USER" >/dev/null 2>&1 || die "the saved user '$A_USER' does not exist"
  RUN_PICKS=$A_PICKS RUN_MISE_EXTRA=$A_MISE_EXTRA
  PLAN=$(resolve $RUN_PICKS)
  if [ "$SECRETS" = 1 ]; then
    read_secrets
    # The terminal is the user's: an interactive Go run hands it over.
    if [ -t 1 ] && [ -e /dev/tty ]; then INTERACTIVE=1; exec < /dev/tty; fi
  fi
  if [ "$BEGIN" = 1 ]; then begin_run; fi
  if [ -n "$ONLY" ]; then only "$ONLY"; fi
  if [ "$FINISH" = 1 ]; then finish_run; fi
  exit 0
fi
if [ "$YES" = 1 ]; then
  [ -n "$A_PICKS" ] || die "no saved choices yet; run devbox-setup without --yes first"
  id "$A_USER" >/dev/null 2>&1 || die "the saved user '$A_USER' does not exist; run devbox-setup without --yes"
  RUN_PICKS=$A_PICKS RUN_MISE_EXTRA=$A_MISE_EXTRA
  PLAN=$(resolve $RUN_PICKS)
else
  { [ -t 0 ] && [ -t 1 ]; } || die "needs a terminal (or --yes to re-apply saved choices)"
  ensure_gum
  INTERACTIVE=1
  while :; do
    ask
    [ "$DRY" = 1 ] && { summary; break; }
    review && break
    MCP_KEYS=() CRED=() REG_USER=() REG_PASS=() AGE_CHOICE= AGE_KEY= GH_TOKEN_IN= GH_PASSPHRASE=
  done
fi

if [ "$DRY" = 1 ]; then dry_run; exit 0; fi
ensure_gum
save_answers
apply
