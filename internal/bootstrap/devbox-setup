ask_mcp() {
  echo
  header "MCPJungle"
  local l all='all interfaces (no auth — trusted networks only)' one='this machine only'
  l=$(gum choose --header "Gateway listens on" \
    --selected "$( [ "${A_MCP_LISTEN:-127.0.0.1}" = 127.0.0.1 ] && echo "$one" || echo "$all")" "$one" "$all")
  case "$l" in all*) A_MCP_LISTEN=0.0.0.0 ;; *) A_MCP_LISTEN=127.0.0.1 ;; esac

  local items s n
  items=$(mktemp)
  {
    echo "T|mcp|MCP servers"
    for s in "$(catalog_dir)"/*.spec; do
      n=$(basename "$s" .spec)
      echo "I|mcp|$n|$n|$(spec_field "$n" DESCRIPTION) · $(spec_field "$n" IMAGE)$(spec_field "$n" URL)"
    done
  } > "$items"
  pick RUN_MCP_SERVERS "MCPJungle — which MCP servers?" "$items" --no-review
  # Servers set up before stay enabled (drop one by editing ~/.mcp/servers).
  A_MCP_SERVERS=$(merge "$A_MCP_SERVERS" "$RUN_MCP_SERVERS")

  if picked claude || picked codex || picked gemini || have claude || user_has codex || user_has gemini; then
    faint "This adds the gateway to $A_USER's Claude Code, Codex and Gemini CLI (those installed), so they can use every MCP server registered in MCPJungle."
    if gum confirm "Add the MCPJungle gateway to $A_USER's coding agents?" \
         --default="$( [ "${A_WIRE_AGENTS:-yes}" = yes ] && echo true || echo false)"; then
      A_WIRE_AGENTS=yes
    else
      A_WIRE_AGENTS=no
    fi
  fi
  ask_mcp_keys
}

ask_mcp_keys() {
  local home n envf skel line key cur val opt
  home=$(home_of "$A_USER")
  for n in $RUN_MCP_SERVERS; do
    envf="$home/.mcp/$n/env"
    skel=$(spec_skeleton "$n")
    # Active KEY= lines are asked for; commented ones are optional extras.
    local active=() optional=()
    while IFS= read -r line; do
      case "$line" in
        [A-Z]*=*) active+=("${line%%=*}") ;;
        \#[A-Z]*=*) key=${line#\#}; optional+=("${key%%=*}") ;;
      esac
    done <<< "$skel"
    [ ${#active[@]} -eq 0 ] && [ ${#optional[@]} -eq 0 ] && continue

    echo
    header "$n — $(spec_field "$n" DESCRIPTION)"
    faint "Leave a value empty to fill it in later in $envf"
    if [ ${#optional[@]} -gt 0 ]; then
      # Not via <(…): a process substitution can't read the terminal.
      local items chosen=
      items=$(mktemp)
      { echo "T|opt|Optional settings"
        for key in "${optional[@]}"; do echo "I|opt|$key|$key|optional · leave unticked to skip"; done
      } > "$items"
      pick chosen "$n — optional settings (enter to skip)" "$items" --no-review
      for opt in $chosen; do active+=("$opt"); done
    fi
    for key in "${active[@]}"; do
      cur=$(envget "$key" "$envf")
      [ -z "$cur" ] && cur=$(sed -n "s/^#\{0,1\}$key=//p" <<< "$skel" | sed -n 1p)
      if is_secret "$key"; then
        val=$(gum input --password --header "$n: $key" --placeholder "$( [ -n "$cur" ] && echo '(unchanged)')")
        [ -z "$val" ] && val=$cur
      else
        val=$(gum input --width 80 --header "$n: $key" --value "$cur")
      fi
      MCP_KEYS["$n $key"]=$val
    done
  done
}

summary() {
  echo
  {
    echo "For user: $A_USER"
    local id
    for id in $PLAN; do
      [ "$(field "$id" 2)" = - ] && [ "$id" != mise ] && continue
      printf '  ✓ %-40s %s\n' "$(label_of "$id")" "$(source_of "$id")"
    done
    [ -n "$RUN_MISE_EXTRA" ] && printf '  ✓ %-40s mise use -g %s\n' "Extra mise tools" "$RUN_MISE_EXTRA"
    if picked mcpjungle; then
      echo "MCPJungle: http://$A_MCP_LISTEN:$MCPJUNGLE_PORT/mcp · servers: ${A_MCP_SERVERS:-none}"
    fi
    picked gitid && [ -n "$A_GIT_NAME$A_GIT_EMAIL" ] && echo "Git: $A_GIT_NAME <$A_GIT_EMAIL>"
    true
  } | sed 's/^/  /'
}

# review — show the plan; returns 0 to install, 1 to start over.
review() {
  summary
  local c
  c=$(gum choose --header "Ready?" "Install" "Start over" "Quit")
  case "$c" in
    Install) return 0 ;;
    "Start over") return 1 ;;
    *) exit 0 ;;
  esac
}

# --- Install steps -------------------------------------------------------------

# A fresh VM often runs unattended-upgrades on first boot: wait for its lock.
# Steps have no terminal, so a "modified config file" question would fail
# the install: keep the existing file instead.
APT_OPTS=(-q -o DPkg::Lock::Timeout=900 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
# DPkg::Lock::Timeout covers installs, not `apt-get update`'s lists lock
# (/var/lib/apt/lists/lock), which cloud-init or apt-daily can hold right
# after boot: retry while another apt holds it, for up to 15 minutes.
apt_update() {
  local out tries=0
  while :; do
    if out=$(apt-get "${APT_OPTS[@]}" update 2>&1); then
      printf '%s\n' "$out"
      touch "$STATE/.apt-fresh"
      return 0
    fi
    case "$out" in
      *"Could not get lock"*)
        [ "$tries" = 0 ] && echo "Waiting for another apt process to finish…"
        tries=$((tries + 1))
        [ "$tries" -le 180 ] || { printf '%s\n' "$out"; return 1; }
        sleep 5 ;;
      *) printf '%s\n' "$out"; return 1 ;;
    esac
  done
}
# NEEDRESTART_MODE=l: list, don't restart. An automatic restart of docker
# mid-run would kill the MCP containers being set up.
apt_install() {
  [ -f "$STATE/.apt-fresh" ] || apt_update
  DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l apt-get "${APT_OPTS[@]}" install -y "$@"
}
# add_key NAME URL — fetch an apt signing key into $KEYRINGS once.
add_key() {
  install -d -m 0755 "$KEYRINGS"
  [ -s "$KEYRINGS/$1" ] && return 0
  # Into place only when complete: a cut-off download would be kept forever.
  local tmp; tmp=$(mktemp)
  if curl -fsSL "$2" -o "$tmp" && [ -s "$tmp" ]; then
    install -m 0644 "$tmp" "$KEYRINGS/$1"; rm -f "$tmp"
  else
    rm -f "$tmp"; echo "could not download the signing key $2" >&2; return 1
  fi
}
# put_file PATH MODE — write stdin to PATH if it differs; returns 0 if changed.
put_file() {
  local tmp; tmp=$(mktemp)
  cat > "$tmp"
  if [ -f "$1" ] && cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
  install -m "$2" "$tmp" "$1"; rm -f "$tmp"
  case "$1" in /etc/apt/*) rm -f "$STATE/.apt-fresh" ;; esac
  return 0
}
as_user() { runuser -u "$A_USER" -- "$@"; }
# note TEXT — show TEXT after the install steps (their own output only goes
# to the log).
note() { echo "$*" >> "$STATE/.notes"; echo "NOTE: $*"; }
in_group() { case " $(id -nG "$A_USER") " in *" $1 "*) return 0 ;; esac; return 1; }
user_home() { home_of "$A_USER"; }
# user_conf SRC DEST — install $CONF/SRC as the user's DEST, keeping an
# existing different file as DEST.orig (once).
user_conf() {
  if [ -f "$2" ] && [ ! -f "$2.orig" ] && ! cmp -s "$CONF/$1" "$2"; then cp -p "$2" "$2.orig"; fi
  as_user install -D -m 0644 "$CONF/$1" "$2"
}
# add_dropin FILE — source the shell drop-in at the end of FILE, once.
add_dropin() {
  [ -f "$1" ] || return 0
  grep -qxF "$DROPIN_LINE" "$1" || printf '\n%s\n' "$DROPIN_LINE" >> "$1"
}
codename() { . /etc/os-release; echo "${VERSION_CODENAME:-noble}"; }

