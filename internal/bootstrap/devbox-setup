#!/usr/bin/env bash
# devbox-setup — pick what to install on this machine, then install it.
#
# pmox puts this script (and the assets in /usr/local/share/devbox-setup) on
# every VM it launches. It is the on-node alternative to applying the
# tack-roles (github.com/tackhq/tack-roles) from outside.
#
#   sudo devbox-setup             choose tools, languages, AI and settings
#   sudo devbox-setup --yes       re-apply the saved choices without asking
#   devbox-setup --dry-run        ask, then show what would happen
#
# Choices (no secrets) are saved in /var/lib/devbox-setup/answers so a re-run
# starts with them ticked. MCP credentials live only in ~/.mcp/<name>/env.
set -euo pipefail

SHARE=${DEVBOX_SETUP_SHARE:-/usr/local/share/devbox-setup}
STATE=${DEVBOX_SETUP_STATE:-/var/lib/devbox-setup}
ANSWERS=$STATE/answers
LOG=$STATE/last-run.log
BIN=/usr/local/bin
KEYRINGS=/etc/apt/keyrings
CATALOG=/usr/local/share/mcp-catalog

GUM_VERSION=2.0.2
MCPJUNGLE_VERSION=0.4.6
MCPJUNGLE_PORT=8080

# Kept in step with tack-roles: roles/devbox/defaults/main.yaml.
DEVBOX_PACKAGES="zsh vim neovim tmux git fd-find silversearcher-ag ripgrep fzf
  git-delta bat gh zoxide eza jq htop tree direnv curl wget unzip
  build-essential ca-certificates"
ZSH_THEME_NAME="powerlevel10k/powerlevel10k"
ZSH_PLUGINS="git terraform kubectl aws wd zsh-fzf-history-search"

# The catalog, in install order:
#   id | screen | label | how | what | needs
# how:  apt (packages) · mise (global tools for the user) · fn (install_<id>)
#       · ask (a setting, no install)
# Labels must not contain commas (gum's --selected splits on them).
CATALOG_ROWS=(
  "devbox|base|CLI tools — git · gh · ripgrep · fzf · delta · neovim · tmux · zellij · …|fn||"
  "shell|base|zsh + oh-my-zsh + powerlevel10k · managed .zshrc/.vimrc|fn||devbox"
  "docker|base|Docker Engine|fn||"
  "podman|base|Podman|apt|podman uidmap slirp4netns|"
  "tailscale|base|Tailscale|fn||"

  "go|lang|Go · golangci-lint|mise|go@latest golangci-lint@latest|"
  "python|lang|Python 3.12 · uv|mise|python@3.12 uv@latest|"
  "node|lang|Node.js LTS · pnpm|mise|node@lts pnpm@latest|"
  "typescript|lang|TypeScript (tsc)|mise|npm:typescript@latest|node"
  "bun|lang|Bun|mise|bun@latest|"
  "deno|lang|Deno|mise|deno@latest|"
  "java|lang|Java 21 · Maven · Gradle|mise|java@21 maven@latest gradle@latest|"
  "kotlin|lang|Kotlin|mise|kotlin@latest|java"
  "rust|lang|Rust (rustup · cargo)|mise|rust@stable|"
  "ruby|lang|Ruby (compiled · takes a few minutes)|mise|ruby@latest|rubydeps"
  "php|lang|PHP · Composer|apt|php-cli php-mbstring php-xml php-curl php-zip php-sqlite3 composer|"
  "cpp|lang|C/C++ — gcc · clang · cmake · ninja · gdb|apt|build-essential clang clangd cmake ninja-build gdb pkg-config|"
  "zig|lang|Zig|mise|zig@latest|"
  "dotnet|lang|.NET SDK|mise|dotnet@latest|"
  "task|lang|Task (Taskfile runner)|mise|task@latest|"

  "aws|cloud|AWS CLI|mise|aws-cli@latest|"
  "gcloud|cloud|Google Cloud CLI|mise|gcloud@latest|"
  "azure|cloud|Azure CLI|mise|uv@latest pipx:azure-cli|"
  "doctl|cloud|DigitalOcean doctl|mise|doctl@latest|"
  "terraform|cloud|Terraform|mise|terraform@latest|"
  "opentofu|cloud|OpenTofu|mise|opentofu@latest|"
  "kubectl|cloud|kubectl|mise|kubectl@latest|"
  "kubectx|cloud|kubectx · kubens|mise|kubectx@latest kubens@latest|"
  "helm|cloud|Helm|mise|helm@latest|"
  "k9s|cloud|k9s|mise|k9s@latest|"

  "claude|ai|Claude Code|fn||"
  "codex|ai|OpenAI Codex CLI|mise|codex@latest|"
  "gemini|ai|Gemini CLI|mise|gemini@latest|node"
  "omp|ai|omp (oh-my-pi) coding agent|fn||"
  "mcpjungle|ai|MCPJungle MCP gateway + MCP servers (in Docker)|fn||docker"

  "gitid|config|Git identity (user.name / user.email)|ask||devbox"
  "sshkey|config|SSH key for $(hostname) (ed25519)|fn||"
  "github|config|Log in to GitHub CLI and add the SSH key to your account|fn||devbox sshkey"
)
# Hidden helpers pulled in by "needs".
HIDDEN_ROWS=(
  "rubydeps|-|Ruby build dependencies|apt|libssl-dev libyaml-dev zlib1g-dev libffi-dev libreadline-dev libgmp-dev|"
  "mise|-|mise|fn||"
)
SCREENS=("base|Base tools and containers" "lang|Languages (installed with mise unless noted)"
         "cloud|Cloud and infrastructure CLIs" "ai|AI tools" "config|Accounts and settings")
DEFAULT_PICKS="devbox shell docker go python node claude gitid sshkey"

YES=0 DRY=0
ARGS=("$@")
usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }
while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes) YES=1 ;;
    -n|--dry-run) DRY=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [ "$DRY" = 0 ] && [ "$(id -u)" != 0 ]; then
  exec sudo "$0" "${ARGS[@]}"
fi

say()  { printf '%s\n' "$*"; }
die()  { printf 'devbox-setup: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

deb_arch() { dpkg --print-architecture 2>/dev/null || echo amd64; }
# Release-tarball arch names used by gum and MCPJungle.
rel_arch() { case "$(deb_arch)" in arm64) echo arm64 ;; *) echo x86_64 ;; esac; }

# --- Catalog lookups -------------------------------------------------------------

# row ID — the catalog row for ID.
row() {
  local r
  for r in "${CATALOG_ROWS[@]}" "${HIDDEN_ROWS[@]}"; do
    [ "${r%%|*}" = "$1" ] && { echo "$r"; return; }
  done
}
# field ID N — field N (1-based) of ID's row.
field() { row "$1" | cut -d'|' -f"$2"; }
label_of() { field "$1" 3; }
how_of()   { field "$1" 4; }
what_of()  { field "$1" 5; }
needs_of() { field "$1" 6; }

# --- Saved answers -----------------------------------------------------------

A_USER= A_PICKS= A_MISE_EXTRA= A_MCP_LISTEN= A_MCP_SERVERS= A_WIRE_CLAUDE= A_GIT_NAME= A_GIT_EMAIL=
ANSWER_VARS="A_USER A_PICKS A_MISE_EXTRA A_MCP_LISTEN A_MCP_SERVERS A_WIRE_CLAUDE A_GIT_NAME A_GIT_EMAIL"
load_answers() {
  # shellcheck disable=SC1090
  [ -r "$ANSWERS" ] && . "$ANSWERS"
  return 0
}
save_answers() {
  mkdir -p "$STATE"; chmod 700 "$STATE"
  {
    echo "# devbox-setup choices ($(date -u +%Y-%m-%dT%H:%M:%SZ)). No secrets here."
    local v
    for v in $ANSWER_VARS; do printf '%s=%q\n' "$v" "${!v}"; done
  } > "$ANSWERS"
  chmod 600 "$ANSWERS"
}

picked() { case " $PLAN " in *" $1 "*) return 0 ;; esac; return 1; }

# resolve IDS — IDS plus everything they need, in catalog order.
resolve() {
  local want=" $* " changed=1 id n
  while [ "$changed" = 1 ]; do
    changed=0
    for id in $want; do
      for n in $(needs_of "$id"); do
        case "$want" in *" $n "*) ;; *) want="$want$n "; changed=1 ;; esac
      done
      if [ "$(how_of "$id")" = mise ]; then
        case "$want" in *" mise "*) ;; *) want="$want""mise "; changed=1 ;; esac
      fi
    done
  done
  [ -n "${A_MISE_EXTRA// /}" ] && case "$want" in *" mise "*) ;; *) want="$want""mise " ;; esac
  # mise and hidden apt helpers go before the first tool that needs them.
  local out= r
  for r in "${HIDDEN_ROWS[@]}" "${CATALOG_ROWS[@]}"; do
    id=${r%%|*}
    case "$want" in *" $id "*) out="$out $id" ;; esac
  done
  echo "${out# }"
}

# --- gum ---------------------------------------------------------------------

ensure_gum() {
  have gum && return 0
  [ "$(id -u)" = 0 ] || die "gum is not installed; run 'sudo devbox-setup' once"
  say "Installing gum $GUM_VERSION (the menu UI)…"
  local t; t=$(mktemp -d)
  curl -fsSL "https://github.com/charmbracelet/gum/releases/download/v$GUM_VERSION/gum_${GUM_VERSION}_Linux_$(rel_arch).tar.gz" \
    | tar -xzf - -C "$t"
  install -m 0755 "$t"/gum_*/gum "$BIN/gum"
  rm -rf "$t"
}

header() { gum style --bold --foreground 212 "$*"; }
faint()  { gum style --faint "$*"; }

# --- MCP catalog helpers -------------------------------------------------------

catalog_dir() { if [ -d "$CATALOG" ]; then echo "$CATALOG"; else echo "$SHARE/mcp-catalog"; fi; }
# spec_field NAME VAR — a variable from the server's spec.
spec_field() { ( . "$(catalog_dir)/$1.spec"; eval "printf '%s' \"\${$2:-}\"" ); }
# spec_skeleton NAME — the env file template from the spec.
spec_skeleton() { ( . "$(catalog_dir)/$1.spec"; skeleton ) 2>/dev/null || true; }

home_of() { getent passwd "$1" | cut -d: -f6; }

# envget KEY FILE
envget() { [ -f "$2" ] || return 0; sed -n "s/^$1=//p" "$2" | tail -n 1; }

# envset KEY VALUE FILE — set KEY in place (uncommenting "#KEY=" if that is
# all there is), or append it.
envset() {
  local tmp; tmp=$(mktemp)
  K="$1" V="$2" awk '
    BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"]; done = 0 }
    !done && ($0 ~ "^" k "=" || $0 ~ "^#[ ]*" k "=") { print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "$3" > "$tmp"
  cat "$tmp" > "$3"; rm -f "$tmp"
}

# MCP_KEYS["server KEY"]=value, collected by the prompts and written by apply.
declare -A MCP_KEYS=()
TS_AUTHKEY=

is_secret() { case "$1" in *TOKEN*|*SECRET*|*PASSWORD*|*_KEY|*_KEY_ID|*APIKEY*) return 0 ;; esac; return 1; }

# --- Prompts -------------------------------------------------------------------

ask() {
  header "devbox-setup"
  faint "Pick what to install. Re-run any time: your choices come back ticked."
  echo

  local u_default=${A_USER:-${SUDO_USER:-$(id -un)}}
  A_USER=$(gum input --header "Set up for which user?" --value "$u_default")
  { [ -n "$A_USER" ] && id "$A_USER" >/dev/null 2>&1; } || die "user '$A_USER' does not exist"

  local prev=" ${A_PICKS:-$DEFAULT_PICKS} " picks= s screen title i=0 r id
  for s in "${SCREENS[@]}"; do
    i=$((i + 1)); screen=${s%%|*}; title=${s#*|}
    local opts=() sel=()
    for r in "${CATALOG_ROWS[@]}"; do
      [ "$(echo "$r" | cut -d'|' -f2)" = "$screen" ] || continue
      id=${r%%|*}
      opts+=("$(label_of "$id")|$id")
      case "$prev" in *" $id "*) sel+=(--selected "$(label_of "$id")") ;; esac
    done
    picks="$picks $(gum choose --no-limit --height 16 --label-delimiter '|' \
      --header "$i/${#SCREENS[@]} $title — space toggles, enter continues" \
      "${sel[@]}" "${opts[@]}" | tr '\n' ' ')"
    if [ "$screen" = lang ]; then
      A_MISE_EXTRA=$(gum input --width 80 --header "Other mise tools (optional, e.g. 'elixir@latest lua@5.4')" \
        --placeholder "none" --value "$A_MISE_EXTRA")
    fi
  done
  A_PICKS=$(echo $picks)
  PLAN=$(resolve $A_PICKS)
  [ -n "$PLAN" ] || { say "Nothing picked."; exit 0; }

  picked gitid && ask_git
  picked mcpjungle && ask_mcp
  if picked tailscale && ! tailscale status >/dev/null 2>&1; then
    TS_AUTHKEY=$(gum input --password --header "Tailscale auth key (empty: run 'sudo tailscale up' later)" || true)
  fi
  return 0
}

ask_git() {
  local cur_name cur_email
  cur_name=$(runuser -u "$A_USER" -- git config --global user.name 2>/dev/null || true)
  cur_email=$(runuser -u "$A_USER" -- git config --global user.email 2>/dev/null || true)
  echo
  header "Git identity"
  faint "Leave empty to take it from your GitHub account after 'gh' login."
  A_GIT_NAME=$(gum input --header "Git user.name" --value "${cur_name:-$A_GIT_NAME}")
  A_GIT_EMAIL=$(gum input --header "Git user.email" --value "${cur_email:-$A_GIT_EMAIL}")
}

ask_mcp() {
  echo
  header "MCPJungle"
  local l all='all interfaces (no auth — trusted networks only)' one='this machine only'
  l=$(gum choose --header "Gateway listens on" \
    --selected "$( [ "${A_MCP_LISTEN:-127.0.0.1}" = 127.0.0.1 ] && echo "$one" || echo "$all")" "$one" "$all")
  case "$l" in all*) A_MCP_LISTEN=0.0.0.0 ;; *) A_MCP_LISTEN=127.0.0.1 ;; esac

  local mopts=() msel=() s n desc
  for s in "$(catalog_dir)"/*.spec; do
    n=$(basename "$s" .spec); desc=$(spec_field "$n" DESCRIPTION); desc=${desc//,/ ·}
    mopts+=("$n — $desc|$n")
    case " ${A_MCP_SERVERS:-context7 sequential-thinking} " in *" $n "*) msel+=(--selected "$n — $desc") ;; esac
  done
  A_MCP_SERVERS=$(gum choose --no-limit --label-delimiter '|' --header "MCP servers" \
    "${msel[@]}" "${mopts[@]}" | tr '\n' ' ')
  A_MCP_SERVERS=$(echo $A_MCP_SERVERS)

  if picked claude || have claude; then
    if gum confirm "Point $A_USER's Claude Code at the gateway?" \
         --default="$( [ "${A_WIRE_CLAUDE:-yes}" = yes ] && echo true || echo false)"; then
      A_WIRE_CLAUDE=yes
    else
      A_WIRE_CLAUDE=no
    fi
  fi
  ask_mcp_keys
}

ask_mcp_keys() {
  local home n envf skel line key cur val opt
  home=$(home_of "$A_USER")
  for n in $A_MCP_SERVERS; do
    envf="$home/.mcp/$n/env"
    skel=$(spec_skeleton "$n")
    # Active KEY= lines are asked for; commented ones are optional extras.
    local active=() optional=()
    while IFS= read -r line; do
      case "$line" in
        [A-Z]*=*) active+=("${line%%=*}") ;;
        \#[A-Z]*=*) key=${line#\#}; optional+=("${key%%=*}") ;;
      esac
    done <<< "$skel"
    [ ${#active[@]} -eq 0 ] && [ ${#optional[@]} -eq 0 ] && continue

    echo
    header "$n — $(spec_field "$n" DESCRIPTION)"
    faint "Leave a value empty to fill it in later in $envf"
    if [ ${#optional[@]} -gt 0 ]; then
      local osel=()
      for key in "${optional[@]}"; do [ -n "$(envget "$key" "$envf")" ] && osel+=(--selected "$key"); done
      # Not via <(…): a process substitution can't read the terminal.
      local chosen
      chosen=$(gum choose --no-limit --header "Optional settings for $n (enter to skip)" \
        "${osel[@]}" "${optional[@]}" || true)
      for opt in $chosen; do active+=("$opt"); done
    fi
    for key in "${active[@]}"; do
      cur=$(envget "$key" "$envf")
      [ -z "$cur" ] && cur=$(sed -n "s/^#\{0,1\}$key=//p" <<< "$skel" | sed -n 1p)
      if is_secret "$key"; then
        val=$(gum input --password --header "$n: $key" --placeholder "$( [ -n "$cur" ] && echo '(unchanged)')")
        [ -z "$val" ] && val=$cur
      else
        val=$(gum input --width 80 --header "$n: $key" --value "$cur")
      fi
      MCP_KEYS["$n $key"]=$val
    done
  done
}

summary() {
  echo
  {
    echo "For user: $A_USER"
    local id
    for id in $PLAN; do [ "$(field "$id" 2)" = - ] || echo "  ✓ $(label_of "$id")"; done
    [ -n "${A_MISE_EXTRA// /}" ] && echo "  ✓ mise: $A_MISE_EXTRA"
    if picked mcpjungle; then
      echo "MCPJungle: http://$A_MCP_LISTEN:$MCPJUNGLE_PORT/mcp"
      echo "MCP servers: ${A_MCP_SERVERS:-none}"
    fi
    picked gitid && [ -n "$A_GIT_NAME$A_GIT_EMAIL" ] && echo "Git: $A_GIT_NAME <$A_GIT_EMAIL>"
    true
  } | gum style --border rounded --padding "0 1" --border-foreground 212
}

# --- Install steps -------------------------------------------------------------

# A fresh VM often runs unattended-upgrades on first boot: wait for its lock.
APT_OPTS=(-q -o DPkg::Lock::Timeout=900)
apt_update() { apt-get "${APT_OPTS[@]}" update; touch "$STATE/.apt-fresh"; }
apt_install() {
  [ -f "$STATE/.apt-fresh" ] || apt_update
  DEBIAN_FRONTEND=noninteractive apt-get "${APT_OPTS[@]}" install -y "$@"
}
# add_key NAME URL — fetch an apt signing key into $KEYRINGS once.
add_key() {
  install -d -m 0755 "$KEYRINGS"
  [ -s "$KEYRINGS/$1" ] || { curl -fsSL "$2" -o "$KEYRINGS/$1"; chmod 0644 "$KEYRINGS/$1"; }
}
# put_file PATH MODE — write stdin to PATH if it differs; returns 0 if changed.
put_file() {
  local tmp; tmp=$(mktemp)
  cat > "$tmp"
  if [ -f "$1" ] && cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
  install -m "$2" "$tmp" "$1"; rm -f "$tmp"
  case "$1" in /etc/apt/*) rm -f "$STATE/.apt-fresh" ;; esac
  return 0
}
as_user() { runuser -u "$A_USER" -- "$@"; }
in_group() { case " $(id -nG "$A_USER") " in *" $1 "*) return 0 ;; esac; return 1; }
user_home() { home_of "$A_USER"; }
codename() { . /etc/os-release; echo "${VERSION_CODENAME:-noble}"; }

install_devbox() {
  # shellcheck disable=SC2086
  apt_install $DEVBOX_PACKAGES
  ln -sfn /usr/bin/fdfind "$BIN/fd"
  ln -sfn /usr/bin/batcat "$BIN/bat"
  if [ ! -x "$BIN/zellij" ]; then
    curl -fsSL "https://github.com/zellij-org/zellij/releases/latest/download/zellij-$(uname -m)-unknown-linux-musl.tar.gz" \
      | tar -xzf - -C "$BIN" zellij
    chmod 0755 "$BIN/zellij"
  fi
}

install_shell() {
  local home; home=$(user_home)
  usermod -s /usr/bin/zsh "$A_USER"
  [ -d "$home/.oh-my-zsh" ] || as_user git clone -q --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$home/.oh-my-zsh"
  [ -d "$home/.oh-my-zsh/custom/themes/powerlevel10k" ] || \
    as_user git clone -q --depth 1 https://github.com/romkatv/powerlevel10k.git "$home/.oh-my-zsh/custom/themes/powerlevel10k"
  [ -d "$home/.oh-my-zsh/custom/plugins/zsh-fzf-history-search" ] || \
    as_user git clone -q --depth 1 https://github.com/joshskidmore/zsh-fzf-history-search.git "$home/.oh-my-zsh/custom/plugins/zsh-fzf-history-search"
  if [ -f "$home/.zshrc" ] && [ ! -f "$home/.zshrc.orig" ]; then cp -p "$home/.zshrc" "$home/.zshrc.orig"; fi
  sed -e "s|{{ .devbox_zsh_theme }}|$ZSH_THEME_NAME|" -e "s|{{ .devbox_zsh_plugins }}|$ZSH_PLUGINS|" \
    "$SHARE/zshrc.tmpl" | put_file "$home/.zshrc" 0644 || true
  chown "$A_USER:" "$home/.zshrc"
  [ -f "$home/.vim/autoload/plug.vim" ] || \
    as_user curl -fsSL --create-dirs https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim -o "$home/.vim/autoload/plug.vim"
  if [ -f "$home/.vimrc" ] && [ ! -f "$home/.vimrc.orig" ]; then cp -p "$home/.vimrc" "$home/.vimrc.orig"; fi
  put_file "$home/.vimrc" 0644 < "$SHARE/vimrc" || true
  chown "$A_USER:" "$home/.vimrc"
  as_user vim -es -u "$home/.vimrc" +PlugInstall +qall </dev/null || true
}

install_docker() {
  apt_install ca-certificates curl
  add_key docker.asc https://download.docker.com/linux/ubuntu/gpg
  put_file /etc/apt/sources.list.d/docker.sources 0644 <<EOF || true
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(codename)
Components: stable
Architectures: $(deb_arch)
Signed-By: $KEYRINGS/docker.asc
EOF
  apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
  in_group docker || usermod -aG docker "$A_USER"
}

install_tailscale() {
  have tailscale || curl -fsSL https://tailscale.com/install.sh | sh
  if [ -n "$TS_AUTHKEY" ]; then tailscale up --authkey "$TS_AUTHKEY"; fi
}

install_mise() {
  local home line='export PATH="$HOME/.local/share/mise/shims:$PATH"'
  home=$(user_home)
  apt_install curl ca-certificates git
  add_key mise-archive-keyring.asc https://mise.jdx.dev/gpg-key.pub
  put_file /etc/apt/sources.list.d/mise.sources 0644 <<EOF || true
Types: deb
URIs: https://mise.jdx.dev/deb
Suites: stable
Components: main
Architectures: $(deb_arch)
Signed-By: $KEYRINGS/mise-archive-keyring.asc
EOF
  apt_install mise
  # Shims on PATH for every shell, including non-interactive ones; for bash
  # the line goes before Ubuntu's "not interactive -> return" guard.
  touch "$home/.zshenv" "$home/.bashrc"
  grep -qxF "$line" "$home/.zshenv" || echo "$line" >> "$home/.zshenv"
  grep -qxF "$line" "$home/.bashrc" || sed -i "1i $line" "$home/.bashrc"
  chown "$A_USER:" "$home/.zshenv" "$home/.bashrc"
}

# mise_use TOOLS... — install tools globally for the user.
mise_use() {
  as_user sh -c 'cd && PATH="$HOME/.local/share/mise/shims:$PATH" mise use -g --yes "$@" && mise reshim' _ "$@"
}

install_claude() {
  apt_install curl gnupg ca-certificates
  add_key claude-code.asc https://downloads.claude.ai/keys/claude-code.asc
  echo "deb [signed-by=$KEYRINGS/claude-code.asc] https://downloads.claude.ai/claude-code/apt/stable stable main" \
    | put_file /etc/apt/sources.list.d/claude-code.list 0644 || true
  apt_install claude-code
}

install_omp() {
  [ -x "$BIN/omp" ] && return 0
  curl -fsSL https://omp.sh/install | PI_INSTALL_DIR="$BIN" sh -s -- --binary
}

install_mcpjungle() {
  local home mcp n key grp
  home=$(user_home); mcp="$home/.mcp"; grp=$(id -gn "$A_USER")
  apt_install curl jq tar
  if [ ! -x "$BIN/mcpjungle" ]; then
    curl -fsSL "https://github.com/mcpjungle/MCPJungle/releases/download/$MCPJUNGLE_VERSION/mcpjungle_Linux_$(rel_arch).tar.gz" \
      | tar -xzf - -C "$BIN" mcpjungle
    chmod 0755 "$BIN/mcpjungle"
  fi
  install -d -m 0755 "$CATALOG"
  install -m 0644 "$SHARE"/mcp-catalog/*.spec "$CATALOG/"
  install -m 0755 "$SHARE/mcp-sync" "$BIN/mcp-sync"
  in_group docker || usermod -aG docker "$A_USER"
  install -d -m 0700 -o "$A_USER" -g "$grp" "$mcp"

  # Same unit as tack-roles' ai-tools role.
  if put_file /etc/systemd/system/mcpjungle.service 0644 <<EOF
[Unit]
Description=MCPJungle MCP gateway
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=$A_USER
SupplementaryGroups=docker
WorkingDirectory=$mcp
# Docker-based servers can take a while to start the first time.
Environment=MCP_SERVER_INIT_REQ_TIMEOUT_SEC=120
# --host= (empty) listens on all interfaces.
ExecStart=$BIN/mcpjungle start --host=$A_MCP_LISTEN --port $MCPJUNGLE_PORT --sqlite-db-path $mcp/mcpjungle.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  then
    systemctl daemon-reload
    systemctl enable mcpjungle
    systemctl restart mcpjungle
  else
    systemctl enable --now mcpjungle
  fi
  local i
  for i in $(seq 60); do
    curl -s -o /dev/null "http://127.0.0.1:$MCPJUNGLE_PORT/" && break
    sleep 1
  done

  # Credentials from the prompts go into each server's env file (the same
  # files mcp-sync creates and reads).
  for n in $A_MCP_SERVERS; do
    install -d -m 0700 -o "$A_USER" -g "$grp" "$mcp/$n"
    [ -f "$mcp/$n/env" ] || spec_skeleton "$n" > "$mcp/$n/env"
  done
  for key in "${!MCP_KEYS[@]}"; do
    envset "${key#* }" "${MCP_KEYS[$key]}" "$mcp/${key%% *}/env"
  done
  for n in $A_MCP_SERVERS; do
    chown "$A_USER:$grp" "$mcp/$n/env"; chmod 600 "$mcp/$n/env"
  done
  if [ "$A_WIRE_CLAUDE" = yes ] && have claude; then
    as_user sh -c "cd && { claude mcp get mcpjungle >/dev/null 2>&1 || claude mcp add --transport http mcpjungle http://localhost:$MCPJUNGLE_PORT/mcp --scope user; }"
  fi
}

install_gitid() {
  [ -n "$A_GIT_NAME" ] && as_user git config --global user.name "$A_GIT_NAME"
  [ -n "$A_GIT_EMAIL" ] && as_user git config --global user.email "$A_GIT_EMAIL"
  as_user git config --global init.defaultBranch main
  return 0
}

install_sshkey() {
  local home; home=$(user_home)
  [ -f "$home/.ssh/id_ed25519" ] && return 0
  as_user sh -c 'mkdir -p ~/.ssh && chmod 700 ~/.ssh'
  as_user ssh-keygen -q -t ed25519 -N "" -C "$A_USER@$(hostname)" -f "$home/.ssh/id_ed25519"
}

# GitHub login is interactive (device code in the browser), so it runs after
# the spinner steps, in the foreground.
github_login() {
  local home pub title login name email
  home=$(user_home); pub="$home/.ssh/id_ed25519.pub"; title="$(hostname) ($A_USER)"
  echo
  header "GitHub"
  if as_user gh auth status -h github.com >/dev/null 2>&1; then
    faint "gh is already logged in."
  else
    faint "Open the URL below on any machine and enter the code."
    as_user sh -c 'cd && gh auth login -h github.com -p ssh --skip-ssh-key -w -s admin:public_key' || {
      gum style --foreground 3 "GitHub login skipped; run 'gh auth login' later."; return 0; }
  fi
  local keys; keys=$(as_user gh ssh-key list 2>/dev/null || true)
  if [ -f "$pub" ] && [[ "$keys" != *"$(cut -d' ' -f2 "$pub")"* ]]; then
    if as_user gh ssh-key add "$pub" --title "$title"; then
      gum style --foreground 2 "✓ SSH key added to GitHub as '$title'"
    else
      gum style --foreground 3 "Could not add the SSH key; add $pub at https://github.com/settings/keys"
    fi
  fi
  as_user sh -c 'ssh-keygen -F github.com >/dev/null 2>&1 || ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null'
  # Fill a missing git identity from the GitHub account.
  if [ -z "$(as_user git config --global user.email 2>/dev/null || true)" ]; then
    login=$(as_user gh api user -q .login 2>/dev/null || true)
    name=$(as_user gh api user -q '.name // .login' 2>/dev/null || true)
    email=$(as_user gh api user -q '.email // empty' 2>/dev/null || true)
    [ -z "$email" ] && [ -n "$login" ] && email="$(as_user gh api user -q .id)+$login@users.noreply.github.com"
    if [ -n "$email" ]; then
      as_user git config --global user.name "$name"
      as_user git config --global user.email "$email"
      gum style --foreground 2 "✓ git identity: $name <$email>"
    fi
  fi
}

# run_id ID — install one catalog entry.
run_id() {
  case "$(how_of "$1")" in
    apt)  # shellcheck disable=SC2046
          apt_install $(what_of "$1") ;;
    mise) # shellcheck disable=SC2046
          mise_use $(what_of "$1") ;;
    fn|ask) "install_$1" ;;
  esac
}

# step ID TITLE CMD... — run CMD with its output in the log, behind a
# spinner; a failure is recorded under ID.
step() {
  local id=$1 title=$2 rc=0; shift 2
  echo "=== $title" >> "$LOG"
  "$@" >> "$LOG" 2>&1 &
  local pid=$!
  if [ -t 1 ]; then
    gum spin --title "$title" -- sh -c "while kill -0 $pid 2>/dev/null; do sleep 0.2; done" || true
  else
    say "… $title"
  fi
  wait "$pid" || rc=$?
  if [ "$rc" -eq 0 ]; then
    gum style --foreground 2 "✓ $title"
  else
    gum style --foreground 1 "✗ $title (exit $rc) — last lines of $LOG:"
    tail -n 25 "$LOG" | sed 's/^/    /'
    FAILED="$FAILED $id"
  fi
  return 0
}

FAILED=
apply() {
  mkdir -p "$STATE"; : > "$LOG"; chmod 600 "$LOG"; rm -f "$STATE/.apt-fresh"
  local id
  for id in $PLAN; do
    [ "$id" = github ] && continue
    # Skip what depends on a step that failed.
    local n skip=
    for n in $(needs_of "$id"); do case " $FAILED " in *" $n "*) skip=$n ;; esac; done
    if [ "$(how_of "$id")" = mise ]; then case " $FAILED " in *" mise "*) skip=mise ;; esac; fi
    if [ -n "$skip" ]; then gum style --foreground 3 "- $(label_of "$id") (skipped: $skip failed)"; continue; fi
    step "$id" "$(label_of "$id")" run_id "$id"
  done
  if [ -n "${A_MISE_EXTRA// /}" ] && ! picked_failed mise; then
    # shellcheck disable=SC2086
    step mise-extra "mise: $A_MISE_EXTRA" mise_use $A_MISE_EXTRA
  fi

  if picked mcpjungle && ! picked_failed mcpjungle; then
    echo
    header "MCP servers"
    as_user env MCP_CATALOG="$CATALOG" MCPJUNGLE_REGISTRY="http://127.0.0.1:$MCPJUNGLE_PORT" \
      "$BIN/mcp-sync" $A_MCP_SERVERS || gum style --foreground 3 "Some servers did not register (see above)."
    faint "Change credentials in ~$A_USER/.mcp/<name>/env, then run mcp-sync as $A_USER."
  fi
  if picked github && ! picked_failed devbox; then github_login; fi

  echo
  if picked tailscale && [ -z "$TS_AUTHKEY" ] && ! tailscale status >/dev/null 2>&1; then
    faint "Tailscale is installed; run 'sudo tailscale up' to log in."
  fi
  faint "Start a new shell (log out and back in) to pick up the new shell, groups and PATH."
  faint "Log: $LOG"
  [ -z "$FAILED" ] || { gum style --foreground 1 "Failed:$FAILED — fix and re-run devbox-setup."; exit 1; }
}
picked_failed() { case " $FAILED " in *" $1 "*) return 0 ;; esac; return 1; }

dry_run() {
  say "user: $A_USER"
  local id
  for id in $PLAN; do
    case "$(how_of "$id")" in
      apt)  say "apt:  $(what_of "$id")" ;;
      mise) say "mise: $(what_of "$id")" ;;
      *)    say "step: $(label_of "$id")" ;;
    esac
  done
  [ -n "${A_MISE_EXTRA// /}" ] && say "mise: $A_MISE_EXTRA"
  picked mcpjungle && say "mcpjungle: listen $A_MCP_LISTEN:$MCPJUNGLE_PORT · servers: $A_MCP_SERVERS · wire claude: ${A_WIRE_CLAUDE:-no}"
  return 0
}

# --- Main ------------------------------------------------------------------------

load_answers
PLAN=$(resolve $A_PICKS)
if [ "$YES" = 1 ]; then
  [ -n "$A_PICKS" ] || die "no saved choices yet; run devbox-setup without --yes first"
else
  { [ -t 0 ] && [ -t 1 ]; } || die "needs a terminal (or --yes to re-apply saved choices)"
  ensure_gum
  ask
  summary
  [ "$DRY" = 1 ] || gum confirm "Install now?" || exit 0
fi

if [ "$DRY" = 1 ]; then dry_run; exit 0; fi
ensure_gum
save_answers
apply
