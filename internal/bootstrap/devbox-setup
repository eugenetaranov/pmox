# add_path_line LINE — put LINE in the user's .zshenv and at the top of
# .bashrc, so every shell has it, including non-interactive ones: for bash
# it goes before Ubuntu's "not interactive -> return" guard.
add_path_line() {
  local home; home=$(user_home)
  touch "$home/.zshenv" "$home/.bashrc"
  grep -qxF "$1" "$home/.zshenv" || echo "$1" >> "$home/.zshenv"
  if ! grep -qxF "$1" "$home/.bashrc"; then
    # sed's "1i" does nothing on an empty file.
    if [ -s "$home/.bashrc" ]; then sed -i "1i $1" "$home/.bashrc"; else echo "$1" > "$home/.bashrc"; fi
  fi
  chown -h "$A_USER:" "$home/.zshenv" "$home/.bashrc"
}

