install_gitcfg() {
  local home kv; home=$(user_home)
  for kv in pull.rebase=true rebase.autoStash=true rebase.autoSquash=true rebase.updateRefs=true \
      push.autoSetupRemote=true push.default=current fetch.prune=true rerere.enabled=true \
      merge.conflictStyle=zdiff3 diff.algorithm=histogram diff.colorMoved=default \
      branch.sort=-committerdate column.ui=auto commit.verbose=true init.defaultBranch=main \
      core.excludesFile=~/.config/git/ignore \
      "alias.st=status -sb" alias.co=checkout alias.br=branch alias.sw=switch \
      "alias.lg=log --graph --oneline --decorate --all" "alias.amend=commit --amend --no-edit"; do
    as_user git config --global "${kv%%=*}" "${kv#*=}"
  done
  if have delta; then
    for kv in core.pager=delta "interactive.diffFilter=delta --color-only" delta.navigate=true delta.line-numbers=true; do
      as_user git config --global "${kv%%=*}" "${kv#*=}"
    done
  fi
  [ -f "$home/.config/git/ignore" ] || as_user install -D -m 0644 "$CONF/gitignore_global" "$home/.config/git/ignore"
  return 0
}

