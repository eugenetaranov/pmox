YES=0 DRY=0 FORGET=0 ONLY= BEGIN=0 FINISH=0 SECRETS=0
ARGS=("$@")
usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }
while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes) YES=1 ;;
    -n|--dry-run) DRY=1 ;;
    -h|--help) usage; exit 0 ;;
    forget) FORGET=1 ;;
    # Used by the Go devbox-setup while it still runs these steps here:
    # --begin (before a run), --only ID (one item, saved answers, no
    # questions), --finish (notes and ~/devbox-setup.txt).
    --only) ONLY=${2:?--only needs an item id}; shift ;;
    --begin) BEGIN=1 ;;
    --finish) FINISH=1 ;;
    # --secrets: read this run's typed secrets from stdin (NUL-separated
    # name/value pairs; never saved), and allow prompts that need the
    # terminal (the GitHub browser login) when there is one.
    --secrets) SECRETS=1 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

[ "$FORGET" = 0 ] || [ "$DRY" = 0 ] || { echo "forget has no --dry-run; it lists what it removes and asks first" >&2; exit 2; }
if [ "$DRY" = 0 ] && [ "$(id -u)" != 0 ]; then
  # Keep a forwarded SSH agent: GitHub's agent mode and signing use it.
  if [ -n "${SSH_AUTH_SOCK:-}" ]; then exec sudo --preserve-env=SSH_AUTH_SOCK "$0" "${ARGS[@]}"; fi
  exec sudo "$0" "${ARGS[@]}"
fi

say()  { printf '%s\n' "$*"; }
die()  { printf 'devbox-setup: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

deb_arch() { dpkg --print-architecture 2>/dev/null || echo amd64; }
# Release-tarball arch names used by gum and MCPJungle.
rel_arch() { case "$(deb_arch)" in arm64) echo arm64 ;; *) echo x86_64 ;; esac; }

# --- Catalog lookups -------------------------------------------------------------

# row ID — the catalog row for ID.
row() {
  local r
  for r in "${CATALOG_ROWS[@]}" "${HIDDEN_ROWS[@]}"; do
    [ "${r%%|*}" = "$1" ] && { echo "$r"; return; }
  done
}
# field ID N — field N (1-based) of ID's row.
field() { row "$1" | cut -d'|' -f"$2"; }
label_of() { field "$1" 3; }
how_of()   { field "$1" 4; }
what_of()  { field "$1" 5; }
needs_of() { field "$1" 6; }

# source_of ID — how ID gets installed, as a command where there is one.
source_of() {
  local what; what=$(what_of "$1")
  case "$(how_of "$1")" in
    mise) echo "mise use -g ${what//@latest/}" ;;
    apt)  echo "apt install $what" ;;
    *)    field "$1" 7 ;;
  esac
}

# --- Saved answers -----------------------------------------------------------

A_USER= A_PICKS= A_MISE_EXTRA= A_MCP_LISTEN= A_MCP_SERVERS= A_WIRE_AGENTS= A_GIT_NAME= A_GIT_EMAIL= A_TZ=
A_GH_MODE= A_NPM_SCOPE= A_NPM_REGISTRY= A_REGISTRIES=
ANSWER_VARS="A_USER A_PICKS A_MISE_EXTRA A_MCP_LISTEN A_MCP_SERVERS A_WIRE_AGENTS A_GIT_NAME A_GIT_EMAIL A_TZ A_GH_MODE A_NPM_SCOPE A_NPM_REGISTRY A_REGISTRIES"
# Saved answers are data ($STATE/answers.json): picker.py parses them (and converts
# the shell-format file older versions wrote, without running it) and hands
# back NUL-separated name/value pairs. Nothing from the file is executed.
load_answers() {
  local k v
  while IFS= read -r -d '' k && IFS= read -r -d '' v; do
    case " $ANSWER_VARS " in *" $k "*) printf -v "$k" '%s' "$v" ;; esac
  done < <(python3 "$SHARE/picker.py" answers read "$STATE")
  return 0
}
save_answers() {
  A_PICKS=$(merge "$A_PICKS" "$RUN_PICKS")
  A_MISE_EXTRA=$(merge "$A_MISE_EXTRA" "$RUN_MISE_EXTRA")
  mkdir -p "$STATE"; chmod 700 "$STATE"
  local v
  for v in $ANSWER_VARS; do printf '%s\0%s\0' "$v" "${!v}"; done \
    | python3 "$SHARE/picker.py" answers write "$STATE"
}

picked() { case " $PLAN " in *" $1 "*) return 0 ;; esac; return 1; }

# This run's picks; the saved A_PICKS / A_MISE_EXTRA accumulate across runs.
RUN_PICKS= RUN_MISE_EXTRA= RUN_MCP_SERVERS= PICKED_MISE=
merge() { printf '%s\n' $1 $2 | awk 'NF && !seen[$0]++' | tr '\n' ' ' | sed 's/ $//'; }

# resolve IDS — IDS plus everything they need, in catalog order.
resolve() {
  local want=" $* " changed=1 id n
  while [ "$changed" = 1 ]; do
    changed=0
    for id in $want; do
      for n in $(needs_of "$id"); do
        case "$want" in *" $n "*) ;; *) want="$want$n "; changed=1 ;; esac
      done
      if [ "$(how_of "$id")" = mise ]; then
        case "$want" in *" mise "*) ;; *) want="$want""mise "; changed=1 ;; esac
      fi
    done
  done
  [ -n "$RUN_MISE_EXTRA" ] && case "$want" in *" mise "*) ;; *) want="$want""mise " ;; esac
  # mise and hidden apt helpers go before the first tool that needs them.
  local out= r
  for r in "${HIDDEN_ROWS[@]}" "${CATALOG_ROWS[@]}"; do
    id=${r%%|*}
    case "$want" in *" $id "*) out="$out $id" ;; esac
  done
  echo "${out# }"
}

# --- gum ---------------------------------------------------------------------

ensure_gum() {
  local v; v=$(gum --version 2>/dev/null || true)
  [[ "$v" == *"v$GUM_VERSION"* ]] && return 0
  [ "$(id -u)" = 0 ] || die "gum is not installed; run 'sudo devbox-setup' once"
  say "Installing gum $GUM_VERSION (the menu UI)…"
  local t arch sum; t=$(mktemp -d); arch=$(rel_arch)
  local tgz="gum_${GUM_VERSION}_Linux_$arch.tar.gz"
  sum=GUM_SHA256_$arch
  curl -fsSL -o "$t/$tgz" "https://github.com/charmbracelet/gum/releases/download/v$GUM_VERSION/$tgz" \
    || { rm -rf "$t"; die "could not download $tgz"; }
  echo "${!sum}  $t/$tgz" | sha256sum -c --status \
    || { rm -rf "$t"; die "$tgz does not match its pinned SHA-256; not installing gum"; }
  tar -xzf "$t/$tgz" -C "$t"
  install -m 0755 "$t"/gum_*/gum "$BIN/gum"
  rm -rf "$t"
}

# Plain ANSI colors: gum 0.17's `style` leaves the terminal so the next
# prompt misses keys.
color()  { printf '\033[%sm%s\033[0m\n' "$1" "$2"; }
header() { color '1;38;5;212' "$*"; }
faint()  { color 2 "$*"; }
ok()     { color 32 "$*"; }
warn()   { color 33 "$*"; }
err()    { color 31 "$*"; }

# pick VAR TITLE ITEMS-FILE [--no-review] — run the tabbed checklist
# (picker.py, curses) and put the chosen ids in VAR. Quitting exits.
pick() {
  local var=$1 title=$2 items=$3 out; shift 3
  out=$(mktemp)
  if ! python3 "$SHARE/picker.py" "$items" --out "$out" --title "$title" "$@"; then
    rm -f "$out" "$items"; say "Cancelled."; exit 0
  fi
  printf -v "$var" '%s' "$(cat "$out")"
  rm -f "$out" "$items"
}

# --- MCP catalog helpers -------------------------------------------------------

# MCP server specs: the installed catalog first, then the ones devbox-setup
# ships (tack-roles' in mcp-catalog/, pmox's own in conf/mcp-catalog/).
spec_dirs() { echo "$CATALOG" "$SHARE/mcp-catalog" "$CONF/mcp-catalog"; }
# spec_file NAME — the spec for NAME, if any.
spec_file() {
  local d
  for d in $(spec_dirs); do [ -f "$d/$1.spec" ] && { echo "$d/$1.spec"; return 0; }; done
  return 1
}
# spec_names — every MCP server name, sorted.
spec_names() {
  local d f
  for d in $(spec_dirs); do
    for f in "$d"/*.spec; do [ -f "$f" ] && basename "$f" .spec; done
  done | sort -u
}
# spec_field NAME VAR — a variable from the server's spec.
spec_field() { ( . "$(spec_file "$1")"; eval "printf '%s' \"\${$2:-}\"" ); }
# spec_skeleton NAME — the env file template from the spec.
spec_skeleton() { ( . "$(spec_file "$1")"; skeleton ) 2>/dev/null || true; }

home_of() { getent passwd "$1" | cut -d: -f6; }

# envget KEY FILE
envget() { [ -f "$2" ] || return 0; sed -n "s/^$1=//p" "$2" | tail -n 1; }

# envset KEY VALUE FILE — set KEY in place (uncommenting "#KEY=" if that is
# all there is), or append it.
envset() {
  local tmp; tmp=$(mktemp)
  K="$1" V="$2" awk '
    BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"]; done = 0 }
    !done && ($0 ~ "^" k "=" || $0 ~ "^#[ ]*" k "=") { print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "$3" > "$tmp"
  cat "$tmp" > "$3"; rm -f "$tmp"
}

# MCP_KEYS["server KEY"]=value, collected by the prompts and written by apply.
declare -A MCP_KEYS=()
TS_AUTHKEY=

is_secret() { case "$1" in *TOKEN*|*SECRET*|*PASSWORD*|*_KEY|*_KEY_ID|*APIKEY*) return 0 ;; esac; return 1; }

# What the credential prompts collected this run, written by apply and
# never saved: CRED["item KEY"] (CRED_ROWS), REG_USER/REG_PASS[registry],
# AGE_CHOICE (generate|paste|later|keep) and AGE_KEY.
declare -A CRED=() REG_USER=() REG_PASS=()
AGE_CHOICE= AGE_KEY= GH_TOKEN_IN= GH_PASSPHRASE=
# 1 when devbox-setup may prompt (not --yes): steps that would wait for
# input leave a note instead.
INTERACTIVE=0
NPMRC_BEGIN='# >>> devbox-setup npmrc' NPMRC_END='# <<< devbox-setup npmrc'
AGENTENV_LINE='[ -r ~/.config/devbox/agent-env.sh ] && . ~/.config/devbox/agent-env.sh'

# record KIND [VALUE] — remember something devbox-setup created, for
# `devbox-setup forget` ($STATE/created.json; never a secret).
record() { python3 "$SHARE/picker.py" created add "$STATE" "$@"; }
# recorded KIND VALUE — record has that entry.
recorded() { python3 "$SHARE/picker.py" created list "$STATE" | grep -qxF "$1	$2"; }

# cred_wanted WHEN — a CRED_ROWS row applies: no WHEN, or WHEN is picked or
# on the user's PATH.
cred_wanted() { [ -z "$1" ] || picked "$1" || user_has "$1"; }

# cred_current ITEM KEY — the secret already in ITEM's file.
cred_current() {
  case "$1" in
    agentkeys) envget "$2" "$(user_home)/.config/devbox/agent.env" ;;
    npmrc) npmrc_token ;;
  esac
}
npmrc_token() {
  local f; f="$(user_home)/.npmrc"
  [ -f "$f" ] || return 0
  sed -n "/^$NPMRC_BEGIN\$/,/^$NPMRC_END\$/s/^.*:_authToken=//p" "$f" | tail -n 1
}

# cred_logged_in KEY — the agent has its own login, so an empty key isn't missing.
cred_logged_in() {
  local h; h=$(user_home)
  case "$1" in
    ANTHROPIC_API_KEY) [ -s "$h/.claude/.credentials.json" ] ;;
    OPENAI_API_KEY) [ -s "$h/.codex/auth.json" ] ;;
    GEMINI_API_KEY) [ -s "$h/.gemini/oauth_creds.json" ] ;;
    *) return 1 ;;
  esac
}

# reg_logged_in REGISTRY — the user's docker config has a login for it.
reg_logged_in() {
  python3 - "$(user_home)/.docker/config.json" "$1" 2>/dev/null <<'EOF'
import json, sys
c = json.load(open(sys.argv[1]))
sys.exit(0 if sys.argv[2] in (c.get("auths") or {}) or sys.argv[2] in (c.get("credHelpers") or {}) else 1)
EOF
}

gh_logged_in() { as_user gh auth status -h github.com >/dev/null 2>&1; }
gh_has_scope() { as_user gh auth status -h github.com 2>&1 | grep -q "Token scopes:.*'$1'"; }

# --- Prompts -------------------------------------------------------------------

ask() {
  header "devbox-setup"
  faint "Pick what to install: nothing is preselected. Run it again any time to add more."
  echo

  local u_default=${A_USER:-${SUDO_USER:-$(id -un)}}
  A_USER=$(gum input --header "Set up for which user?" --value "$u_default")
  { [ -n "$A_USER" ] && id "$A_USER" >/dev/null 2>&1; } || die "user '$A_USER' does not exist"

  # 1. Pick: one tabbed checklist over every category.
  local items s r id
  items=$(mktemp)
  {
    for s in "${SCREENS[@]}"; do echo "T|${s%%|*}|${s#*|}"; done
    for r in "${CATALOG_ROWS[@]}"; do
      id=${r%%|*}
      echo "I|$(field "$id" 2)|$id|$(label_of "$id")|$(source_of "$id")"
    done
  } > "$items"
  local reg; reg=$(mise_registry_file)
  pick RUN_PICKS "devbox-setup — pick what to install" "$items" ${reg:+--mise "$reg"}
  case "$reg" in "$SHARE"/*|"$STATE"/*|"") ;; *) rm -f "$reg" ;; esac
  split_mise_picks

  # 2. Type (every text prompt in one place).
  ask_mise_extra
  PLAN=$(resolve $RUN_PICKS)
  [ -n "$PLAN" ] || { say "Nothing picked."; exit 0; }
  picked gitid && ask_git
  picked tzlocale && ask_tz
  picked mcpjungle && ask_mcp
  picked github && ask_github
  ask_creds
  picked registries && ask_registries
  picked agekey && ask_agekey
  if picked tailscale && ! tailscale status >/dev/null 2>&1; then
    TS_AUTHKEY=$(gum input --password --header "Tailscale auth key (empty: run 'sudo tailscale up' later)" || true)
  fi
  return 0
}

# mise_registry_file — mise's registry for the picker's search, best first:
# the live one when mise is installed; pmox's full snapshot (with
# descriptions) from GitHub, cached for a week; the names-only copy pmox
# ships (the full one does not fit in cloud-init's user-data).
mise_registry_file() {
  local f cache=$STATE/mise-registry.tsv
  if have mise; then
    f=$(mktemp)
    if timeout 15 mise registry -J --hide-aliased 2>/dev/null |
        python3 "$SHARE/picker.py" --registry-tsv > "$f" 2>/dev/null && [ -s "$f" ]; then
      echo "$f"; return 0
    fi
    rm -f "$f"
  fi
  if [ -z "$(find "$cache" -mtime -7 2>/dev/null)" ] && mkdir -p "$STATE" 2>/dev/null; then
    f=$(mktemp)
    if curl -fsS --max-time 5 -o "$f" "$MISE_REGISTRY_URL" 2>/dev/null && [ -s "$f" ] &&
        [ "$(head -c 1 "$f")" != "<" ]; then
      install -m 0644 "$f" "$cache" 2>/dev/null || true
    fi
    rm -f "$f"
  fi
  if [ -s "$cache" ]; then echo "$cache"
  elif [ -s "$SHARE/mise-registry.tsv" ]; then echo "$SHARE/mise-registry.tsv"
  fi
  return 0
}

# split_mise_picks — registry tools picked in the search come back as
# mise:<name>; they become extra mise tools (PICKED_MISE).
split_mise_picks() {
  local p picks=
  PICKED_MISE=
  for p in $RUN_PICKS; do
    case "$p" in
      mise:*) PICKED_MISE="$PICKED_MISE ${p#mise:}" ;;
      *) picks="$picks $p" ;;
    esac
  done
  RUN_PICKS=$(echo $picks) PICKED_MISE=$(echo $PICKED_MISE)
}

# ask_mise_extra — optional extra mise tools, prefilled with the ones
# picked in the search, checked against mise's registry when mise is
# already installed.
ask_mise_extra() {
  local val=$PICKED_MISE bad t
  while :; do
    val=$(gum input --width 80 --header "Extra mise tools, space-separated (e.g. just sops@3), blank to skip" \
      --placeholder "none" --value "${val:-}")
    RUN_MISE_EXTRA=$(echo $val)
    [ -n "$RUN_MISE_EXTRA" ] && have mise || return 0
    bad=
    for t in $RUN_MISE_EXTRA; do
      t=${t%%@*}
      case "$t" in *:*) continue ;; esac # backend:tool, can't check offline
      mise registry "$t" >/dev/null 2>&1 || bad="$bad $t"
    done
    [ -z "$bad" ] && return 0
    warn "Not in mise's registry:$bad — fix or clear them."
  done
}

ask_git() {
  local cur_name cur_email
  cur_name=$(runuser -u "$A_USER" -- git config --global user.name 2>/dev/null || true)
  cur_email=$(runuser -u "$A_USER" -- git config --global user.email 2>/dev/null || true)
  echo
  header "Git identity"
  faint "Leave empty to take it from your GitHub account after 'gh' login."
  A_GIT_NAME=$(gum input --header "Git user.name" --value "${cur_name:-$A_GIT_NAME}")
  A_GIT_EMAIL=$(gum input --header "Git user.email" --value "${cur_email:-$A_GIT_EMAIL}")
}

ask_tz() {
  local cur tz
  cur=${A_TZ:-$(timedatectl show -p Timezone --value 2>/dev/null || echo Etc/UTC)}
  echo
  header "Timezone"
  while :; do
    tz=$(gum input --header "Timezone (e.g. Europe/Berlin, America/New_York)" --value "$cur")
    timedatectl list-timezones 2>/dev/null | grep -qxF "$tz" && break
    warn "Unknown timezone '$tz'."
    cur=$tz
  done
  A_TZ=$tz
}

ask_github() {
  local agent="Forwarded SSH agent (no key on this VM; connect with pmox shell -A)" \
        key="A key on this VM (~/.ssh/id_ed25519, uploaded to GitHub)" \
        token="A fine-grained token (git over HTTPS; no key)" def c
  def=${A_GH_MODE:-}
  if [ -z "$def" ]; then
    if [ -n "${SSH_AUTH_SOCK:-}" ] && ssh-add -l >/dev/null 2>&1; then def=agent; else def=key; fi
  fi
  echo
  header "GitHub"
  c=$(gum choose --header "How should this VM reach GitHub?" --selected "${!def}" "$agent" "$key" "$token" || true)
  case "$c" in "$agent") A_GH_MODE=agent ;; "$token") A_GH_MODE=token ;; *) A_GH_MODE=key ;; esac
  if [ "$A_GH_MODE" = key ] && [ ! -f "$(user_home)/.ssh/id_ed25519" ]; then
    if gum confirm "Protect the new key with a passphrase? (ssh-keygen asks after the installs)" --default=false; then
      GH_PASSPHRASE=yes
    fi
  fi
  if [ "$A_GH_MODE" = token ] && ! gh_logged_in; then
    faint "Create one at https://github.com/settings/personal-access-tokens (Contents: read/write on your repos)."
    GH_TOKEN_IN=$(gum input --password --header "GitHub fine-grained token (empty: later)" || true)
  fi
  return 0
}

# ask_creds — the CRED_ROWS prompts for the picked items.
ask_creds() {
  local r item key kind prompt how when def shown= cur
  for r in "${CRED_ROWS[@]}"; do
    IFS='|' read -r item key kind prompt how when def <<< "$r"
    { picked "$item" && cred_wanted "$when"; } || continue
    if [ "$shown" != "$item" ]; then
      echo
      header "$(label_of "$item")"
      faint "Leave a value empty to fill it in later: ~/devbox-setup.txt lists what is missing."
      shown=$item
    fi
    if [ "$kind" = secret ]; then
      cur=$(cred_current "$item" "$key")
      CRED["$item $key"]=$(gum input --password --header "$prompt" --placeholder "$( [ -n "$cur" ] && echo '(unchanged)')" || true)
    else
      cur=${!kind:-$def}
      printf -v "$kind" '%s' "$(gum input --width 80 --header "$prompt" --value "$cur" || true)"
    fi
  done
  if [ -n "$A_NPM_SCOPE" ] && [ "${A_NPM_SCOPE#@}" = "$A_NPM_SCOPE" ]; then A_NPM_SCOPE="@$A_NPM_SCOPE"; fi
  return 0
}

ask_registries() {
  local regs r
  echo
  header "Container registry logins"
  faint "Each is logged in with 'docker login' as $A_USER. Empty password: later (ghcr.io uses the gh token when it has read:packages)."
  regs=$(gum input --width 80 --header "Registries, space-separated (e.g. ghcr.io registry.gitlab.com)" --value "${A_REGISTRIES:-ghcr.io}" || true)
  # shellcheck disable=SC2086
  A_REGISTRIES=$(echo $regs)
  for r in $A_REGISTRIES; do
    if reg_logged_in "$r"; then faint "$r: already logged in."; continue; fi
    REG_USER[$r]=$(gum input --header "$r: username" || true)
    REG_PASS[$r]=$(gum input --password --header "$r: password or token" || true)
  done
}

ask_agekey() {
  local f; f="$(user_home)/.config/sops/age/keys.txt"
  if grep -q '^AGE-SECRET-KEY-' "$f" 2>/dev/null; then AGE_CHOICE=keep; return 0; fi
  echo
  header "age key for sops"
  case "$(gum choose --header "age key for $A_USER" "Generate a new key" "Paste an existing key" "Later" || true)" in
    Gen*) AGE_CHOICE=generate ;;
    Paste*)
      AGE_CHOICE=paste
      AGE_KEY=$(gum input --password --header "age secret key (AGE-SECRET-KEY-1…)" || true)
      [ -n "$AGE_KEY" ] || AGE_CHOICE=later ;;
    *) AGE_CHOICE=later ;;
  esac
}

ask_mcp() {
  echo
  header "MCPJungle"
  local l all='all interfaces (no auth — trusted networks only)' one='this machine only'
  l=$(gum choose --header "Gateway listens on" \
    --selected "$( [ "${A_MCP_LISTEN:-127.0.0.1}" = 127.0.0.1 ] && echo "$one" || echo "$all")" "$one" "$all")
  case "$l" in all*) A_MCP_LISTEN=0.0.0.0 ;; *) A_MCP_LISTEN=127.0.0.1 ;; esac

  local items s n
  items=$(mktemp)
  {
    echo "T|mcp|MCP servers"
    for n in $(spec_names); do
      echo "I|mcp|$n|$n|$(spec_field "$n" DESCRIPTION) · $(spec_field "$n" IMAGE)$(spec_field "$n" URL)"
    done
  } > "$items"
  pick RUN_MCP_SERVERS "MCPJungle — which MCP servers?" "$items" --no-review
  # Servers set up before stay enabled (drop one by editing ~/.mcp/servers).
  A_MCP_SERVERS=$(merge "$A_MCP_SERVERS" "$RUN_MCP_SERVERS")

  if picked claude || picked codex || picked gemini || have claude || user_has codex || user_has gemini; then
    faint "This adds the gateway to $A_USER's Claude Code, Codex and Gemini CLI (those installed), so they can use every MCP server registered in MCPJungle."
    if gum confirm "Add the MCPJungle gateway to $A_USER's coding agents?" \
         --default="$( [ "${A_WIRE_AGENTS:-yes}" = yes ] && echo true || echo false)"; then
      A_WIRE_AGENTS=yes
    else
      A_WIRE_AGENTS=no
    fi
  fi
  ask_mcp_keys
}

ask_mcp_keys() {
  local home n envf skel line key cur val opt
  home=$(home_of "$A_USER")
  for n in $RUN_MCP_SERVERS; do
    envf="$home/.mcp/$n/env"
    skel=$(spec_skeleton "$n")
    # Active KEY= lines are asked for; commented ones are optional extras.
    local active=() optional=()
    while IFS= read -r line; do
      case "$line" in
        [A-Z]*=*) active+=("${line%%=*}") ;;
        \#[A-Z]*=*) key=${line#\#}; optional+=("${key%%=*}") ;;
      esac
    done <<< "$skel"
    [ ${#active[@]} -eq 0 ] && [ ${#optional[@]} -eq 0 ] && continue

    echo
    header "$n — $(spec_field "$n" DESCRIPTION)"
    faint "Leave a value empty to fill it in later in $envf"
    if [ ${#optional[@]} -gt 0 ]; then
      # Not via <(…): a process substitution can't read the terminal.
      local items chosen=
      items=$(mktemp)
      { echo "T|opt|Optional settings"
        for key in "${optional[@]}"; do echo "I|opt|$key|$key|optional · leave unticked to skip"; done
      } > "$items"
      pick chosen "$n — optional settings (enter to skip)" "$items" --no-review
      for opt in $chosen; do active+=("$opt"); done
    fi
    for key in "${active[@]}"; do
      cur=$(envget "$key" "$envf")
      [ -z "$cur" ] && cur=$(sed -n "s/^#\{0,1\}$key=//p" <<< "$skel" | sed -n 1p)
      if is_secret "$key"; then
        val=$(gum input --password --header "$n: $key" --placeholder "$( [ -n "$cur" ] && echo '(unchanged)')")
        [ -z "$val" ] && val=$cur
      else
        val=$(gum input --width 80 --header "$n: $key" --value "$cur")
      fi
      MCP_KEYS["$n $key"]=$val
    done
  done
}

summary() {
  echo
  {
    echo "For user: $A_USER"
    local id
    for id in $PLAN; do
      [ "$(field "$id" 2)" = - ] && [ "$id" != mise ] && continue
      printf '  ✓ %-40s %s\n' "$(label_of "$id")" "$(source_of "$id")"
    done
    [ -n "$RUN_MISE_EXTRA" ] && printf '  ✓ %-40s mise use -g %s\n' "Extra mise tools" "$RUN_MISE_EXTRA"
    if picked mcpjungle; then
      echo "MCPJungle: http://$A_MCP_LISTEN:$MCPJUNGLE_PORT/mcp · servers: ${A_MCP_SERVERS:-none}"
    fi
    picked gitid && [ -n "$A_GIT_NAME$A_GIT_EMAIL" ] && echo "Git: $A_GIT_NAME <$A_GIT_EMAIL>"
    picked github && echo "GitHub: ${A_GH_MODE:-key}"
    true
  } | sed 's/^/  /'
}

# review — show the plan; returns 0 to install, 1 to start over.
review() {
  summary
  local c
  c=$(gum choose --header "Ready?" "Install" "Start over" "Quit")
  case "$c" in
    Install) return 0 ;;
    "Start over") return 1 ;;
    *) exit 0 ;;
  esac
}

# --- Install steps -------------------------------------------------------------

# A fresh VM often runs unattended-upgrades on first boot: wait for its lock.
# Steps have no terminal, so a "modified config file" question would fail
# the install: keep the existing file instead.
APT_OPTS=(-q -o DPkg::Lock::Timeout=900 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
# DPkg::Lock::Timeout covers installs, not `apt-get update`'s lists lock
# (/var/lib/apt/lists/lock), which cloud-init or apt-daily can hold right
# after boot: retry while another apt holds it, for up to 15 minutes.
apt_update() {
  local out tries=0
  while :; do
    if out=$(apt-get "${APT_OPTS[@]}" update 2>&1); then
      printf '%s\n' "$out"
      touch "$STATE/.apt-fresh"
      return 0
    fi
    case "$out" in
      *"Could not get lock"*)
        [ "$tries" = 0 ] && echo "Waiting for another apt process to finish…"
        tries=$((tries + 1))
        [ "$tries" -le 180 ] || { printf '%s\n' "$out"; return 1; }
        sleep 5 ;;
      *) printf '%s\n' "$out"; return 1 ;;
    esac
  done
}
# NEEDRESTART_MODE=l: list, don't restart. An automatic restart of docker
# mid-run would kill the MCP containers being set up.
apt_install() {
  [ -f "$STATE/.apt-fresh" ] || apt_update
  DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l apt-get "${APT_OPTS[@]}" install -y "$@"
}
# add_key NAME URL — fetch an apt signing key into $KEYRINGS once.
add_key() {
  install -d -m 0755 "$KEYRINGS"
  [ -s "$KEYRINGS/$1" ] && return 0
  # Into place only when complete: a cut-off download would be kept forever.
  local tmp; tmp=$(mktemp)
  if curl -fsSL "$2" -o "$tmp" && [ -s "$tmp" ]; then
    install -m 0644 "$tmp" "$KEYRINGS/$1"; rm -f "$tmp"
  else
    rm -f "$tmp"; echo "could not download the signing key $2" >&2; return 1
  fi
}
# put_file PATH MODE — write stdin to PATH if it differs; returns 0 if changed.
put_file() {
  local tmp; tmp=$(mktemp)
  cat > "$tmp"
  if [ -f "$1" ] && cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
  install -m "$2" "$tmp" "$1"; rm -f "$tmp"
  case "$1" in /etc/apt/*) rm -f "$STATE/.apt-fresh" ;; esac
  return 0
}
as_user() { runuser -u "$A_USER" -- "$@"; }
# note TEXT — show TEXT after the install steps (their own output only goes
# to the log).
note() { echo "$*" >> "$STATE/.notes"; echo "NOTE: $*"; }
in_group() { case " $(id -nG "$A_USER") " in *" $1 "*) return 0 ;; esac; return 1; }
user_home() { home_of "$A_USER"; }
# user_conf SRC DEST — install $CONF/SRC as the user's DEST, keeping an
# existing different file as DEST.orig (once).
user_conf() {
  if [ -f "$2" ] && [ ! -f "$2.orig" ] && ! cmp -s "$CONF/$1" "$2"; then cp -p "$2" "$2.orig"; fi
  as_user install -D -m 0644 "$CONF/$1" "$2"
}
# add_dropin FILE [LINE] — add LINE (the shell drop-in) at the end of FILE, once.
add_dropin() {
  local line=${2:-$DROPIN_LINE} mark='# devbox: local overrides (keep last)' tmp
  [ -f "$1" ] || return 0
  grep -qxF "$line" "$1" && return 0
  if grep -qxF "$mark" "$1"; then
    # Before the block sourcing the user's local file, which stays last.
    tmp=$(mktemp) || return 1
    awk -v l="$line" -v m="$mark" '$0 == m && !done { print l; print ""; done = 1 } { print }' "$1" > "$tmp" &&
      cat "$tmp" > "$1"
    rm -f "$tmp"
  else
    printf '\n%s\n' "$line" >> "$1"
  fi
}
codename() { . /etc/os-release; echo "${VERSION_CODENAME:-noble}"; }

install_cli() {
  apt_install ripgrep fd-find bat eza zoxide fzf git-delta direnv tree
  # Ubuntu renames these two; link the usual names.
  ln -sfn /usr/bin/fdfind "$BIN/fd"
  ln -sfn /usr/bin/batcat "$BIN/bat"
}

install_zsh() {
  local home; home=$(user_home)
  apt_install zsh git
  usermod -s /usr/bin/zsh "$A_USER"
  # Without a .zshrc, zsh opens its new-user menu at first login.
  [ -e "$home/.zshrc" ] || as_user touch "$home/.zshrc"
}

install_zshcfg() {
  local home theme=$DEFAULT_ZSH_THEME; home=$(user_home)
  [ -d "$home/.oh-my-zsh" ] || as_user git clone -q --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$home/.oh-my-zsh"
  local repo
  for repo in joshskidmore/zsh-fzf-history-search zsh-users/zsh-autosuggestions zsh-users/zsh-syntax-highlighting; do
    [ -d "$home/.oh-my-zsh/custom/plugins/${repo#*/}" ] || \
      as_user git clone -q --depth 1 "https://github.com/$repo.git" "$home/.oh-my-zsh/custom/plugins/${repo#*/}"
  done
  if [ -f "$home/.zshrc" ] && [ ! -f "$home/.zshrc.orig" ]; then cp -p "$home/.zshrc" "$home/.zshrc.orig"; fi
  # Re-rendering keeps the prompt: the theme follows the p10k clone.
  [ -d "$home/.oh-my-zsh/custom/themes/powerlevel10k" ] && theme=$P10K_THEME
  # Plugins are chosen by the template at shell start (installed tools).
  sed -e "s|{{ .devbox_zsh_theme }}|$theme|" "$CONF/zshrc.tmpl" | put_file "$home/.zshrc" 0644 || true
  chown -h "$A_USER:" "$home/.zshrc"
  as_user install -D -m 0644 "$CONF/completions.zsh" "$home/.config/devbox/completions.zsh"
  # The template replaced .zshrc: keep the shell drop-in if it is set up.
  [ -f "$home/.config/devbox/shell.sh" ] && add_dropin "$home/.zshrc"
  [ -f "$home/.config/devbox/agent-env.sh" ] && add_dropin "$home/.zshrc" "$AGENTENV_LINE"
  return 0
}

# install_p10k — the theme, a ready ~/.p10k.zsh (lean preset + our style;
# kept if the user already has one), and the theme line in .zshrc.
install_p10k() {
  local home; home=$(user_home)
  [ -d "$home/.oh-my-zsh/custom/themes/powerlevel10k" ] || \
    as_user git clone -q --depth 1 https://github.com/romkatv/powerlevel10k.git "$home/.oh-my-zsh/custom/themes/powerlevel10k"
