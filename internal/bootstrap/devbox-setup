#!/usr/bin/env bash
# devbox-setup — pick what to install on this machine, then install it.
#
# pmox puts this script (and the assets in /usr/local/share/devbox-setup) on
# every VM it launches. It is the on-node alternative to applying the
# tack-roles (github.com/tackhq/tack-roles) from outside.
#
#   sudo devbox-setup             choose tools, languages, AI and settings
#   sudo devbox-setup --yes       re-apply everything chosen so far, no questions
#   devbox-setup --dry-run        ask, then show what would happen
#   sudo devbox-setup forget      remove the keys, logins and secrets it set up
#
# Nothing is preselected. Everything ever chosen (no secrets) accumulates in
# /var/lib/devbox-setup/answers.json, and ~/devbox-setup.txt lists how each tool
# was installed and how to manage it.
#
# Credentials are never stored anywhere but their own config file: an item
# that needs one asks once (empty = later) and writes the file at 0600; one
# left empty is listed under "Secrets to fill in" in ~/devbox-setup.txt.
set -euo pipefail

SHARE=${DEVBOX_SETUP_SHARE:-/usr/local/share/devbox-setup}
