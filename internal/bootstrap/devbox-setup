APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF
  echo 'Unattended-Upgrade::Automatic-Reboot "false";' | put_file /etc/apt/apt.conf.d/52devbox 0644 || true
  # pmox's bootcmd turns the timers off at every boot unless this exists.
  install -d -m 0755 "$(dirname "$AUTO_UPGRADES_MARKER")"
