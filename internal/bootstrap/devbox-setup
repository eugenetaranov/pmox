# as_user_sh CMD — run CMD in a login-less sh as the user, from their home,
# with the mise shims on PATH.
# user_has CMD — CMD is on the user's PATH (mise tools are not on root's).
user_has() { as_user_sh "command -v $1" >/dev/null 2>&1; }
as_user_sh() { as_user sh -c "cd && PATH=\"\$HOME/.local/share/mise/shims:\$PATH\" && $1"; }

