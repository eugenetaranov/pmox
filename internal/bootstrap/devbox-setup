# new_user_file FILE — create FILE from stdin as the user, private (0600),
# unless it exists; recorded for forget. Returns 1 if it already existed.
new_user_file() {
  if [ -e "$1" ]; then cat > /dev/null; return 1; fi
  as_user mkdir -p "$(dirname "$1")"
  as_user sh -c 'umask 077; cat > "$1"' _ "$1"
  record file "$1"
}

install_agentkeys() {
  local home f r item key kind prompt how when def; home=$(user_home); f="$home/.config/devbox/agent.env"
  {
    echo "# Agent API keys, written by devbox-setup and read by interactive shells."
    echo "# Fill in a key, then open a new shell. Not shared with services or cron."
    for r in "${CRED_ROWS[@]}"; do
      IFS='|' read -r item key kind prompt how when def <<< "$r"
      [ "$item" = agentkeys ] || continue
      printf '\n# %s: %s\n%s=\n' "$prompt" "$how" "$key"
    done
  } | new_user_file "$f" || true
  for r in "${CRED_ROWS[@]}"; do
    IFS='|' read -r item key kind prompt how when def <<< "$r"
    [ "$item" = agentkeys ] && [ -n "${CRED[agentkeys $key]:-}" ] && envset "$key" "${CRED[agentkeys $key]}" "$f"
  done
  chmod 600 "$f"
  as_user install -D -m 0644 "$CONF/agent-env.sh" "$home/.config/devbox/agent-env.sh"
  as_user touch "$home/.bashrc"
  add_dropin "$home/.bashrc" "$AGENTENV_LINE"
  add_dropin "$home/.zshrc" "$AGENTENV_LINE"
}

install_npmrc() {
  local home f reg tok tmp; home=$(user_home); f="$home/.npmrc"
  reg=${A_NPM_REGISTRY:-https://npm.pkg.github.com}; reg=${reg%/}
  tok=${CRED[npmrc NPM_TOKEN]:-$(npmrc_token)}
  if [ -z "$A_NPM_SCOPE" ]; then
    note "npmrc: no npm scope set; run 'sudo devbox-setup' and pick 'Private npm registry' again."
    return 0
  fi
  # A file devbox-setup created is its own; in yours it adds only a block.
  if [ ! -e "$f" ]; then : | new_user_file "$f"; elif ! recorded file "$f"; then record block "$f"; fi
  tmp=$(mktemp)
  awk -v b="$NPMRC_BEGIN" -v e="$NPMRC_END" '$0 == b { skip = 1 } !skip { print } $0 == e { skip = 0 }' "$f" > "$tmp"
  printf '%s\n' "$NPMRC_BEGIN" "$A_NPM_SCOPE:registry=$reg/" "//${reg#*://}/:_authToken=$tok" "$NPMRC_END" >> "$tmp"
  cat "$tmp" > "$f"; rm -f "$tmp"
  chmod 600 "$f"
}

# install_registries — runs after the GitHub login (ghcr.io can use its token).
install_registries() {
  local r u p rc=0
  for r in $A_REGISTRIES; do
    reg_logged_in "$r" && continue
    u=${REG_USER[$r]:-} p=${REG_PASS[$r]:-}
    if [ -z "$p" ] && [ "$r" = ghcr.io ] && gh_has_scope read:packages; then
      p=$(as_user gh auth token)
      [ -n "$u" ] || u=$(as_user gh api user -q .login)
    fi
    { [ -n "$p" ] && [ -n "$u" ]; } || continue
    if printf '%s' "$p" | as_user docker login "$r" -u "$u" --password-stdin >/dev/null; then
      record registry "$r"
    else
      echo "docker login $r failed" >&2; rc=1
    fi
  done
  return "$rc"
}

install_agekey() {
  local home f; home=$(user_home); f="$home/.config/sops/age/keys.txt"
  case "${AGE_CHOICE:-}" in
    generate)
      if ! grep -q '^AGE-SECRET-KEY-' "$f" 2>/dev/null; then
        [ -e "$f" ] || record file "$f"
        as_user mkdir -p "$(dirname "$f")"
        rm -f "$f"
        as_user_sh "umask 077; age-keygen -o '$f'"
      fi ;;
    paste)
      if ! grep -q '^AGE-SECRET-KEY-' "$f" 2>/dev/null; then
        [ -e "$f" ] || record file "$f"
        as_user mkdir -p "$(dirname "$f")"
        printf '%s\n' "$AGE_KEY" | as_user sh -c 'umask 077; cat >> "$1"' _ "$f"
      fi ;;
  esac
  echo "# age key for sops: paste a line AGE-SECRET-KEY-1… here, or run: age-keygen -o ~/.config/sops/age/keys.txt" \
    | new_user_file "$f" || true
  chmod 600 "$f"
  add_path_line 'export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"'
  local pub; pub=$(as_user_sh "age-keygen -y '$f'" 2>/dev/null || true)
  [ -z "$pub" ] || [ "$AGE_CHOICE" != generate ] || note "age: new key; its public key is $pub"
  return 0
}

install_mcpjungle() {
  local home mcp n key grp
  home=$(user_home); mcp="$home/.mcp"; grp=$(id -gn "$A_USER")
  apt_install curl jq tar
  if [ ! -x "$BIN/mcpjungle" ]; then
    curl -fsSL "https://github.com/mcpjungle/MCPJungle/releases/download/$MCPJUNGLE_VERSION/mcpjungle_Linux_$(rel_arch).tar.gz" \
      | tar -xzf - -C "$BIN" mcpjungle
    chmod 0755 "$BIN/mcpjungle"
  fi
  install -d -m 0755 "$CATALOG"
  install -m 0644 "$SHARE"/mcp-catalog/*.spec "$CONF"/mcp-catalog/*.spec "$CATALOG/"
  install -m 0755 "$SHARE/mcp-sync" "$BIN/mcp-sync"
  in_group docker || usermod -aG docker "$A_USER"
  install -d -m 0700 -o "$A_USER" -g "$grp" "$mcp"

  # Same unit as tack-roles' ai-tools role.
  if put_file /etc/systemd/system/mcpjungle.service 0644 <<EOF
[Unit]
Description=MCPJungle MCP gateway
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=$A_USER
SupplementaryGroups=docker
WorkingDirectory=$mcp
# Docker-based servers can take a while to start the first time.
Environment=MCP_SERVER_INIT_REQ_TIMEOUT_SEC=120
# --host is 127.0.0.1 (this machine) or 0.0.0.0 (all interfaces).
ExecStart=$BIN/mcpjungle start --host=$A_MCP_LISTEN --port $MCPJUNGLE_PORT --sqlite-db-path $mcp/mcpjungle.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  then
    systemctl daemon-reload
    systemctl enable mcpjungle
    systemctl restart mcpjungle
  else
    systemctl enable --now mcpjungle
  fi
  local i up=
  for i in $(seq 60); do
    curl -s -o /dev/null "http://127.0.0.1:$MCPJUNGLE_PORT/" && { up=1; break; }
    sleep 1
  done
  [ -n "$up" ] || note "mcpjungle is not answering on port $MCPJUNGLE_PORT after 60s; see: journalctl -u mcpjungle"

  # Credentials from the prompts go into each server's env file (the same
  # files mcp-sync creates and reads).
  for n in $A_MCP_SERVERS; do
    install -d -m 0700 -o "$A_USER" -g "$grp" "$mcp/$n"
    [ -f "$mcp/$n/env" ] || { spec_skeleton "$n" > "$mcp/$n/env"; record file "$mcp/$n/env"; }
  done
  for key in "${!MCP_KEYS[@]}"; do
    envset "${key#* }" "${MCP_KEYS[$key]}" "$mcp/${key%% *}/env"
  done
  for n in $A_MCP_SERVERS; do
    chown -h "$A_USER:$grp" "$mcp/$n/env"; chmod 600 "$mcp/$n/env"
  done
  [ "$A_WIRE_AGENTS" = yes ] && wire_agents
  return 0
}

# wire_agents — register the MCPJungle gateway with each installed agent,
# once.
wire_agents() {
  local home url f tmp; home=$(user_home); url="http://localhost:$MCPJUNGLE_PORT/mcp"
  if have claude; then
    as_user sh -c "cd && { claude mcp get mcpjungle >/dev/null 2>&1 || claude mcp add --transport http mcpjungle $url --scope user; }"
  fi
  if user_has codex; then
    f="$home/.codex/config.toml"
    if ! grep -qxF '[mcp_servers.mcpjungle]' "$f" 2>/dev/null; then
      as_user install -d -m 0700 "$home/.codex"
      as_user sh -c "printf '\n[mcp_servers.mcpjungle]\nurl = \"%s\"\n' '$url' >> '$f'"
    fi
  fi
  if user_has gemini; then
    f="$home/.gemini/settings.json"
    as_user install -d -m 0700 "$home/.gemini"
    [ -s "$f" ] || echo '{}' | as_user tee "$f" >/dev/null
    if ! jq -e '.mcpServers.mcpjungle' "$f" >/dev/null 2>&1; then
      tmp=$(mktemp)
      jq --arg u "$url" '.mcpServers.mcpjungle = {httpUrl: $u}' "$f" > "$tmp" && cat "$tmp" > "$f"
      rm -f "$tmp"
    fi
  fi
}

install_gitid() {
