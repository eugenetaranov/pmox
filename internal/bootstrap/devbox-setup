[Unit]
Description=MCPJungle MCP gateway
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=$A_USER
SupplementaryGroups=docker
WorkingDirectory=$mcp
# Docker-based servers can take a while to start the first time.
Environment=MCP_SERVER_INIT_REQ_TIMEOUT_SEC=120
# --host is 127.0.0.1 (this machine) or 0.0.0.0 (all interfaces).
ExecStart=$BIN/mcpjungle start --host=$A_MCP_LISTEN --port $MCPJUNGLE_PORT --sqlite-db-path $mcp/mcpjungle.db
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  then
    systemctl daemon-reload
    systemctl enable mcpjungle
    systemctl restart mcpjungle
  else
    systemctl enable --now mcpjungle
  fi
  local i up=
  for i in $(seq 60); do
    curl -s -o /dev/null "http://127.0.0.1:$MCPJUNGLE_PORT/" && { up=1; break; }
    sleep 1
  done
  [ -n "$up" ] || note "mcpjungle is not answering on port $MCPJUNGLE_PORT after 60s; see: journalctl -u mcpjungle"

  # Credentials from the prompts go into each server's env file (the same
  # files mcp-sync creates and reads).
  for n in $A_MCP_SERVERS; do
    install -d -m 0700 -o "$A_USER" -g "$grp" "$mcp/$n"
    [ -f "$mcp/$n/env" ] || spec_skeleton "$n" > "$mcp/$n/env"
  done
  for key in "${!MCP_KEYS[@]}"; do
    envset "${key#* }" "${MCP_KEYS[$key]}" "$mcp/${key%% *}/env"
  done
  for n in $A_MCP_SERVERS; do
    chown -h "$A_USER:$grp" "$mcp/$n/env"; chmod 600 "$mcp/$n/env"
  done
  [ "$A_WIRE_AGENTS" = yes ] && wire_agents
  return 0
}

# wire_agents — register the MCPJungle gateway with each installed agent,
# once.
wire_agents() {
  local home url f tmp; home=$(user_home); url="http://localhost:$MCPJUNGLE_PORT/mcp"
  if have claude; then
    as_user sh -c "cd && { claude mcp get mcpjungle >/dev/null 2>&1 || claude mcp add --transport http mcpjungle $url --scope user; }"
  fi
  if user_has codex; then
    f="$home/.codex/config.toml"
    if ! grep -qxF '[mcp_servers.mcpjungle]' "$f" 2>/dev/null; then
      as_user install -d -m 0700 "$home/.codex"
      as_user sh -c "printf '\n[mcp_servers.mcpjungle]\nurl = \"%s\"\n' '$url' >> '$f'"
    fi
  fi
  if user_has gemini; then
    f="$home/.gemini/settings.json"
    as_user install -d -m 0700 "$home/.gemini"
    [ -s "$f" ] || echo '{}' | as_user tee "$f" >/dev/null
    if ! jq -e '.mcpServers.mcpjungle' "$f" >/dev/null 2>&1; then
      tmp=$(mktemp)
      jq --arg u "$url" '.mcpServers.mcpjungle = {httpUrl: $u}' "$f" > "$tmp" && cat "$tmp" > "$f"
      rm -f "$tmp"
    fi
  fi
}

install_gitid() {
  [ -n "$A_GIT_NAME" ] && as_user git config --global user.name "$A_GIT_NAME"
  [ -n "$A_GIT_EMAIL" ] && as_user git config --global user.email "$A_GIT_EMAIL"
  as_user git config --global init.defaultBranch main
  return 0
}

install_gitcfg() {
  local home kv; home=$(user_home)
  for kv in pull.rebase=true rebase.autoStash=true rebase.autoSquash=true rebase.updateRefs=true \
      push.autoSetupRemote=true push.default=current fetch.prune=true rerere.enabled=true \
      merge.conflictStyle=zdiff3 diff.algorithm=histogram diff.colorMoved=default \
      branch.sort=-committerdate column.ui=auto commit.verbose=true init.defaultBranch=main \
      core.excludesFile=~/.config/git/ignore \
      "alias.st=status -sb" alias.co=checkout alias.br=branch alias.sw=switch \
      "alias.lg=log --graph --oneline --decorate --all" "alias.amend=commit --amend --no-edit"; do
    as_user git config --global "${kv%%=*}" "${kv#*=}"
  done
  if have delta; then
    for kv in core.pager=delta "interactive.diffFilter=delta --color-only" delta.navigate=true delta.line-numbers=true; do
      as_user git config --global "${kv%%=*}" "${kv#*=}"
    done
  fi
  [ -f "$home/.config/git/ignore" ] || as_user install -D -m 0644 "$CONF/gitignore_global" "$home/.config/git/ignore"
  return 0
}

install_sshkey() {
  local home; home=$(user_home)
  [ -f "$home/.ssh/id_ed25519" ] && return 0
  as_user sh -c 'mkdir -p ~/.ssh && chmod 700 ~/.ssh'
  as_user ssh-keygen -q -t ed25519 -N "" -C "$A_USER@$(hostname)" -f "$home/.ssh/id_ed25519"
}

# GitHub login is interactive (device code in the browser), so it runs after
# the spinner steps, in the foreground.
github_login() {
  local home pub title login name email
  home=$(user_home); pub="$home/.ssh/id_ed25519.pub"; title="$(hostname) ($A_USER)"
  echo
  header "GitHub"
  if as_user gh auth status -h github.com >/dev/null 2>&1; then
    faint "gh is already logged in."
  else
    faint "Open the URL below on any machine and enter the code."
    as_user sh -c 'cd && gh auth login -h github.com -p ssh --skip-ssh-key -w -s admin:public_key' || {
      warn "GitHub login skipped; run 'gh auth login' later."; return 0; }
  fi
  local keys; keys=$(as_user gh ssh-key list 2>/dev/null || true)
  if [ -f "$pub" ] && [[ "$keys" != *"$(cut -d' ' -f2 "$pub")"* ]]; then
    if as_user gh ssh-key add "$pub" --title "$title"; then
      ok "✓ SSH key added to GitHub as '$title'"
    else
      warn "Could not add the SSH key; add $pub at https://github.com/settings/keys"
    fi
  fi
  as_user sh -c 'ssh-keygen -F github.com >/dev/null 2>&1 || ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null'
  # Fill a missing git identity from the GitHub account.
  if [ -z "$(as_user git config --global user.email 2>/dev/null || true)" ]; then
    login=$(as_user gh api user -q .login 2>/dev/null || true)
    name=$(as_user gh api user -q '.name // .login' 2>/dev/null || true)
    email=$(as_user gh api user -q '.email // empty' 2>/dev/null || true)
    [ -z "$email" ] && [ -n "$login" ] && email="$(as_user gh api user -q .id)+$login@users.noreply.github.com"
    if [ -n "$email" ]; then
      as_user git config --global user.name "$name"
      as_user git config --global user.email "$email"
      ok "✓ git identity: $name <$email>"
    fi
  fi
}

# run_id ID — install one catalog entry.
run_id() {
  case "$(how_of "$1")" in
    apt)  # shellcheck disable=SC2046
          apt_install $(what_of "$1") ;;
    mise) # shellcheck disable=SC2046
          mise_use $(what_of "$1") ;;
    fn|ask) "install_$1" ;;
  esac
  # post_ID: settings that go with an apt or mise item.
  if declare -F "post_$1" >/dev/null; then "post_$1"; fi
}

# step ID TITLE CMD... — run CMD with its output in the log, behind a
# spinner; a failure is recorded under ID.
step() {
  local id=$1 title=$2 rc=0; shift 2
  echo "=== $title" >> "$LOG"
  "$@" >> "$LOG" 2>&1 &
  local pid=$!
  if [ -t 1 ]; then
    gum spin --title "$title" -- sh -c "while kill -0 $pid 2>/dev/null; do sleep 0.2; done" || true
  else
    say "… $title"
  fi
  wait "$pid" || rc=$?
  if [ "$rc" -eq 0 ]; then
    ok "✓ $title"
  else
    err "✗ $title (exit $rc) — last lines of $LOG:"
    tail -n 25 "$LOG" | sed 's/^/    /'
    FAILED="$FAILED $id"
  fi
  return 0
}

FAILED=
apply() {
  mkdir -p "$STATE"; : > "$LOG"; chmod 600 "$LOG"; rm -f "$STATE/.apt-fresh" "$STATE/.notes"
  # Every apt-get waits for the dpkg lock instead of failing, including
  # those inside vendor install scripts (tailscale, …). pmox also turns off
  # unattended-upgrades at boot; this covers older VMs and other hosts.
  printf '%s\n' 'DPkg::Lock::Timeout "900";' \
    'Dpkg::Options { "--force-confdef"; "--force-confold"; };' \
    | put_file /etc/apt/apt.conf.d/90devbox-setup 0644 || true
  local id
  for id in $PLAN; do
    [ "$id" = github ] && continue
    # Skip what depends on a step that failed.
    local n skip=
    for n in $(needs_of "$id"); do case " $FAILED " in *" $n "*) skip=$n ;; esac; done
    if [ "$(how_of "$id")" = mise ]; then case " $FAILED " in *" mise "*) skip=mise ;; esac; fi
    if [ -n "$skip" ]; then warn "- $(label_of "$id") (skipped: $skip failed)"; continue; fi
    step "$id" "$(label_of "$id")" run_id "$id"
  done
  if [ -n "$RUN_MISE_EXTRA" ] && ! picked_failed mise; then
    # shellcheck disable=SC2086
    step mise-extra "mise: $RUN_MISE_EXTRA" mise_use $RUN_MISE_EXTRA
  fi

  if picked mcpjungle && ! picked_failed mcpjungle; then
    echo
    header "MCP servers"
    curl -s -o /dev/null "http://127.0.0.1:$MCPJUNGLE_PORT/" || \
      warn "mcpjungle is not answering on port $MCPJUNGLE_PORT; check: journalctl -u mcpjungle"
    as_user env MCP_CATALOG="$CATALOG" MCPJUNGLE_REGISTRY="http://127.0.0.1:$MCPJUNGLE_PORT" \
      "$BIN/mcp-sync" $A_MCP_SERVERS || warn "Some servers did not register (see above)."
    faint "Change credentials in ~$A_USER/.mcp/<name>/env, then run mcp-sync as $A_USER."
  fi
  if picked github && ! picked_failed essentials; then github_login; fi

  if [ -s "$STATE/.notes" ]; then
    echo
    while IFS= read -r l; do warn "! $l"; done < "$STATE/.notes"
  fi
  echo
  write_manage_notes
  if picked tailscale && [ -z "$TS_AUTHKEY" ] && ! tailscale status >/dev/null 2>&1; then
    faint "Tailscale is installed; run 'sudo tailscale up' to log in."
  fi
  faint "How each tool was installed and how to update it: ~$A_USER/devbox-setup.txt"
  faint "Start a new shell (log out and back in) to pick up the new shell, groups and PATH."
  faint "Log: $LOG"
  [ -z "$FAILED" ] || { err "Failed:$FAILED — fix and re-run devbox-setup."; exit 1; }
}
picked_failed() { case " $FAILED " in *" $1 "*) return 0 ;; esac; return 1; }

# write_manage_notes — ~/devbox-setup.txt: everything installed so far,
# grouped by how it was installed, with how to manage it.
write_manage_notes() {
  local all id mise_l= apt_l= other_l= f
  all=$(resolve "$(merge "$A_PICKS" "$RUN_PICKS")")
  for id in $all; do
    [ "$id" = mise ] && continue
    local how; how=$(how_of "$id")
    [[ "$(source_of "$id")" == "apt install "* ]] && how=apt
    case "$how" in
      mise) mise_l="$mise_l  $(printf '%-40s' "$(label_of "$id")") $(source_of "$id")\n" ;;
      apt)  apt_l="$apt_l  $(printf '%-40s' "$(label_of "$id")") $(source_of "$id")\n" ;;
      *)    other_l="$other_l  $(printf '%-40s' "$(label_of "$id")") $(source_of "$id")\n" ;;
    esac
  done
  local extra; extra=$(merge "$A_MISE_EXTRA" "$RUN_MISE_EXTRA")
  [ -n "$extra" ] && mise_l="$mise_l  $(printf '%-40s' "Extra mise tools") mise use -g $extra\n"
  f="$(user_home)/devbox-setup.txt"
  {
    echo "devbox-setup — what is installed and how to manage it (updated $(date -u +%Y-%m-%d))"
    echo
    if [ -n "$mise_l" ]; then
      echo "Installed with mise (per user, ~/.config/mise/config.toml):"
      printf '%b' "$mise_l"
      echo "  update all: mise up · list: mise ls · pin: mise use -g <tool>@<version> · remove: mise rm -g <tool>"
      echo
    fi
    if [ -n "$apt_l" ]; then
      echo "Installed with apt (system):"
      printf '%b' "$apt_l"
      echo "  update: sudo apt update && sudo apt upgrade · remove: sudo apt remove <package>"
      echo
    fi
    if [ -n "$other_l" ]; then
      echo "Vendor repos, release binaries, scripts and settings:"
      printf '%b' "$other_l"
      echo "  vendor apt repos update with apt upgrade; claude and omp update themselves."
      echo
    fi
    echo "Run 'sudo devbox-setup' again to add more."
  } > "$f"
  chown -h "$A_USER:" "$f"
}

dry_run() {
  say "user: $A_USER"
  local id
  for id in $PLAN; do
    case "$(how_of "$id")" in
      apt)  say "apt:  $(what_of "$id")" ;;
      mise) say "mise: $(what_of "$id")" ;;
      *)    say "step: $(label_of "$id")" ;;
    esac
  done
  [ -n "$RUN_MISE_EXTRA" ] && say "mise: $RUN_MISE_EXTRA"
  picked mcpjungle && say "mcpjungle: listen $A_MCP_LISTEN:$MCPJUNGLE_PORT · servers: $A_MCP_SERVERS · wire agents: ${A_WIRE_AGENTS:-no}"
  return 0
}

# --- Main ------------------------------------------------------------------------

load_answers
if [ "$YES" = 1 ]; then
  [ -n "$A_PICKS" ] || die "no saved choices yet; run devbox-setup without --yes first"
  RUN_PICKS=$A_PICKS RUN_MISE_EXTRA=$A_MISE_EXTRA
  PLAN=$(resolve $RUN_PICKS)
else
  { [ -t 0 ] && [ -t 1 ]; } || die "needs a terminal (or --yes to re-apply saved choices)"
  ensure_gum
  while :; do
    ask
    [ "$DRY" = 1 ] && { summary; break; }
    review && break
    MCP_KEYS=()
  done
fi

if [ "$DRY" = 1 ]; then dry_run; exit 0; fi
ensure_gum
save_answers
apply
